+								agc_cfg_ram + i / 4);
+			if (ret) {
+				AICWFDBG(LOGERROR, "agc upload fail: %x, err:%d\r\n",
+					 agc_cfg_addr + i, ret);
+			}
+		}
+
+#if !defined(CONFIG_FPGA_VERIFICATION)
+		if ((IS_CHIP_ID_H())) {
+			txgain_cfg_size =3D sizeof(txgain_map_h);
+			txgain_cfg_array =3D (u32 *)txgain_map_h;
+		} else {
