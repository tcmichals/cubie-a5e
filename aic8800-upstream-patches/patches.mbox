+	switch (opcode[1]) {
+	case HCI_EV_LE_Meta: {
+		u8 subevent_code;
+
+		subevent_code = opcode[3];
+		switch (subevent_code) {
+		case HCI_BLE_ADV_PKT_RPT_EVT:
+		case HCI_LE_EXTENDED_ADVERTISING_REPORT_EVT: {
+			if (aic_queue_cnt() > (QUEUE_SIZE - 490)) {
