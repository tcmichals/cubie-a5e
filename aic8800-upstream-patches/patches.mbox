+ * c>>d  [label=3D"Request accepted"];
+ * ...   [label=3D"(several Tx cfm can be pushed)"];
+ * b<:c  [label=3D"Tx cfm queue filled IRQ"];
+ * a<<=3Db [label=3D"Driver's Tx Confirm callback"];
+ * a=3D>b  [label=3D"ipc_host_txcfm_pop()"];
