+
+	if (wait_for_completion_timeout(&aic_chipup_comp, msecs_to_jiffies(2000))=
) {
+		aicbsp_unreg_sdio_notify();
+		return 0;
+	}
+
+	aicbsp_unreg_sdio_notify();
+
+	return -1;
+}
