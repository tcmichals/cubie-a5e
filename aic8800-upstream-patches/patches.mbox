+	head = &pq->queuelist;
+	list_for_each_safe(pos, n, head) {
+		tempbuf = list_entry(pos, struct rx_buff, queue);
+		list_del_init(&tempbuf->queue);
+		aicwf_prealloc_rxbuff_free(tempbuf, &rx_priv->rxbuff_lock);
+		pq->qcnt--;
+	}
+}
