+DEBUGFS_READ_FUNC(last_rx);
+DEBUGFS_WRITE_FUNC(last_rx);
+static const struct file_operations rwnx_dbgfs_last_rx_ops = {
+	.write = rwnx_dbgfs_last_rx_write,
+	.read = rwnx_dbgfs_last_rx_read,
+	.open = simple_open,
+	.llseek = generic_file_llseek,
+}
