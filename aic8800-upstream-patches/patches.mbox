+int aicwf_request_firmware(const struct firmware **fw, const char *name,
+			   struct device *dev)
+{
+	char *fw_name;
+	int ret;
+
+	if (!name || !name[0])
+		return -EINVAL;
+
+	fw_name =3D kasprintf(GFP_KERNEL, AIC8800_FW_DIR "%s", name);
+	if (!fw_name)
+		return -ENOMEM;
+
+	ret =3D request_firmware(fw, fw_name, dev);
+	kfree(fw_name);
+
+	return ret;
+}
