+	if (aicwifi_sys_config_8800d80(sdiodev)) {
+		pr_err("aicbsp aicwifi_patch_config_8800d80 fail\n");
+		return -1;
+	}
+
+	if (aicwifi_start_from_bootrom(sdiodev)) {
