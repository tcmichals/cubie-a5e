+	}
+
+	skb = alloc_skb(len, GFP_ATOMIC);
+	if (!skb)
+		AICWFDBG(LOGERROR, "alloc skb fail %s\n", __func__);
+	memcpy(skb_put(skb, len), data, len);
+	if (bt_bypass_event(skb)) {
+		kfree_skb(skb);
+		return 0;
+	}
+	// bt_data_dump("bt_skb", skb, skb->len); //debug trace
+
+	if (aic_enqueue(skb) < 0) {
