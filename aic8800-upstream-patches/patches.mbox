+		return -1;
+	}
+	if (is_chip_id_h) {
+		AICWFDBG(LOGINFO, "IS_CHIP_ID_H\n");
+		*aicbsp_firmware_list =3D fw_8800dc_h_u02;
+	} else {
+		if (aicbsp_info->chip_rev =3D=3D CHIP_REV_U01)
+			*aicbsp_firmware_list =3D fw_8800dc_u01;
+		else
+			*aicbsp_firmware_list =3D fw_8800dc_u02;
+	}
