+
+	/* Build the ADD_IF_REQ message */
+	add_if_req_param =3D rwnx_msg_zalloc(MM_ADD_IF_REQ, TASK_MM, DRV_TASK_ID,
+					   sizeof(struct mm_add_if_req));
