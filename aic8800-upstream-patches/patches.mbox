+		// wakeup_source_unregister(ws_rx_sdio);
+		// wakeup_source_unregister(ws_sdio_pwrctrl);
+	}
+	free_irq(hostwake_irq_num, NULL);
+#endif // CONFIG_GPIO_WAKEUP
+	AICWFDBG(LOGINFO, "%s(%d)\n", __func__, __LINE__);
+	return 0;
