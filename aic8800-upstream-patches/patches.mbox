+
+	if (aicbt_patch_trap_data_load(sdiodev, head)) {
+		pr_err("aicbsp aicbt_patch_trap_data_load fail\n");
+		ret =3D -1;
+		goto err;
+	}
+
+	if (aicbt_patch_table_load(sdiodev, head)) {
+		pr_err("aicbsp aicbt_patch_table_load fail\n");
+		ret =3D -1;
+		goto err;
+	}
+
+err:
+	aicbt_patch_table_free(&head);
+	return ret;
+}
