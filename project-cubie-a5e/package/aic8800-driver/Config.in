config BR2_PACKAGE_AIC8800_DRIVER
	bool "aic8800-driver (upstream mainline)"
	depends on BR2_LINUX_KERNEL
	help
	  AIC8800 FullMAC Wi-Fi driver from upstream wireless-next.
	  Builds two modules: aic8800_bsp.ko (BSP/firmware) and
	  aic8800_fdrv.ko (cfg80211 WLAN).

if BR2_PACKAGE_AIC8800_DRIVER

config BR2_PACKAGE_AIC8800_DRIVER_SDIO
	bool "Enable SDIO bus transport (Cubie A5E)"
	default y
	help
	  Enable SDIO transport for AIC8800 on Cubie A5E. Without the
	  USB option this builds the RFC v3 tree (aic8800-rfcv3).

config BR2_PACKAGE_AIC8800_DRIVER_USB
	bool "Enable USB bus transport (Cubie A7A)"
	default y
	help
	  Enable USB transport for AIC8800 on Cubie A7A. This builds the
	  unified tree (aic8800-upstream): RFC v3 has no USB transport yet.

endif
