From: Tim Michals <tcmichals@gmail.com>
Date: Fri, 21 Aug 2026 12:00:00 +0000
Subject: [PATCH] remoteproc: sunxi: add allwinner riscv remoteproc driver

---
 drivers/remoteproc/Kconfig       |   9 +
 drivers/remoteproc/Makefile      |   1 +
 drivers/remoteproc/sunxi_rproc.c | 552 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 562 insertions(+)
 create mode 100644 drivers/remoteproc/sunxi_rproc.c

--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -381,5 +381,14 @@ config XLNX_R5_REMOTEPROC
 	  It's safe to say N if not interested in using RPU r5f cores.
 
+config SUNXI_REMOTEPROC
+	tristate "Allwinner XuanTie RISC-V remoteproc support"
+	depends on (ARCH_SUNXI || COMPILE_TEST)
+	default y
+	help
+	  Say y or m here to support the Allwinner XuanTie E907/E902 RISC-V
+	  co-processor on Allwinner A523, A527, T527, and A733 SoCs via the
+	  remote processor framework.
+
 endif # REMOTEPROC
 
 endmenu
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -40,3 +40,4 @@
 obj-$(CONFIG_TI_K3_M4_REMOTEPROC)	+= ti_k3_m4_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_TI_K3_R5_REMOTEPROC)	+= ti_k3_r5_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_XLNX_R5_REMOTEPROC)	+= xlnx_r5_remoteproc.o
+obj-$(CONFIG_SUNXI_REMOTEPROC)		+= sunxi_rproc.o
--- /dev/null
+++ b/drivers/remoteproc/sunxi_rproc.c
@@ -0,0 +1,524 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Allwinner XuanTie E907/E902 RISC-V Remote Processor Driver
+ *
+ * Copyright (C) 2024-2026 Allwinner Technology Co., Ltd.
+ * Copyright (C) 2026 Tim Michals <tcmichals@gmail.com>
+ *
+ * CCU-integrated remoteproc driver for XuanTie RISC-V co-processors on
+ * Allwinner SoCs (A523, A527, T527, A733) supporting TCM, SRAM, and DRAM.
+ */
+
+#include <linux/clk.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mailbox_client.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/remoteproc.h>
+#include <linux/reset.h>
+
+#include "remoteproc_internal.h"
+
+#define DRIVER_NAME "sunxi-rproc"
+
+/* RISC-V Core Configuration Registers */
+#define RISCV_STA_ADD_OFFSET	0x0204
+
+/* XuanTie E907 core-local view of its tightly coupled memories */
+#define E907_ITCM_DA	0x00000000
+#define E907_DTCM_DA	0x00080000
+
+struct sunxi_rproc {
+	struct rproc *rproc;
+	struct device *dev;
+
+	/* CCU Clocks & Resets */
+	struct clk *clk_parent;
+	struct clk *clk_bus;
+	struct clk *clk_core;
+	struct reset_control *rst_cfg;
+	struct reset_control *rst_core;
+	struct reset_control *rst_module;
+
+	/* Hardware Memory Windows (TCM, Dedicated SRAM & Shared System SRAM) */
+	void __iomem *cfg_va;
+	void __iomem *itcm_va;
+	phys_addr_t itcm_phys;
+	size_t itcm_size;
+
+	void __iomem *dtcm_va;
+	phys_addr_t dtcm_phys;
+	size_t dtcm_size;
+
+	void __iomem *r_sram_va;
+	phys_addr_t r_sram_phys;
+	size_t r_sram_size;
+
+	void __iomem *sram_va;
+	phys_addr_t sram_phys;
+	size_t sram_size;
+
+	/* Mailbox State */
+	struct mbox_client cl;
+	struct mbox_chan *tx_chan;
+};
+
+static int sunxi_rproc_mem_alloc(struct rproc *rproc,
+				 struct rproc_mem_entry *mem)
+{
+	mem->va = memremap(mem->dma, mem->len, MEMREMAP_WB);
+	if (!mem->va) {
+		dev_err(rproc->dev.parent, "failed to map reserved memory %pad+%zx\n",
+			&mem->dma, mem->len);
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static int sunxi_rproc_mem_release(struct rproc *rproc,
+				   struct rproc_mem_entry *mem)
+{
+	memunmap(mem->va);
+	return 0;
+}
+
+static int sunxi_rproc_register_carveouts(struct rproc *rproc)
+{
+	struct device *dev = rproc->dev.parent;
+	struct device_node *np = dev->of_node;
+	struct rproc_mem_entry *mem;
+	struct resource res;
+	int index = 0;
+	int ret;
+
+	while (!(ret = of_reserved_mem_region_to_resource(np, index++, &res))) {
+		if (res.start > U32_MAX || resource_size(&res) > U32_MAX)
+			return -EINVAL;
+
+		mem = rproc_mem_entry_init(dev, NULL, (dma_addr_t)res.start,
+					   resource_size(&res), (u32)res.start,
+					   sunxi_rproc_mem_alloc,
+					   sunxi_rproc_mem_release,
+					   "%.*s", strchrnul(res.name, '@') - res.name,
+					   res.name);
+		if (!mem)
+			return -ENOMEM;
+
+		rproc_add_carveout(rproc, mem);
+	}
+
+	return 0;
+}
+
+static void sunxi_rproc_mb_rx_callback(struct mbox_client *cl, void *data)
+{
+	struct sunxi_rproc *priv = container_of(cl, struct sunxi_rproc, cl);
+
+	/* Signal remoteproc virtqueue on incoming mailbox doorbell */
+	rproc_vq_interrupt(priv->rproc, 0);
+}
+
+static irqreturn_t sunxi_rproc_crash_handler(int irq, void *data)
+{
+	struct rproc *rproc = data;
+	struct sunxi_rproc *priv = rproc->priv;
+
+	dev_err(priv->dev, "Hardware crash event received from XuanTie RISC-V core!\n");
+	rproc_report_crash(rproc, RPROC_FATAL_ERROR);
+
+	return IRQ_HANDLED;
+}
+
+static int sunxi_rproc_prepare(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+	int ret;
+
+	ret = sunxi_rproc_register_carveouts(rproc);
+	if (ret)
+		return ret;
+
+	/* 1. Deassert configuration bus reset */
+	if (priv->rst_cfg) {
+		ret = reset_control_deassert(priv->rst_cfg);
+		if (ret) {
+			dev_err(priv->dev, "failed to deassert cfg reset: %d\n", ret);
+			return ret;
+		}
+	}
+
+	/* 2. Enable parent clock (PLL / DSP source) */
+	if (priv->clk_parent) {
+		ret = clk_prepare_enable(priv->clk_parent);
+		if (ret) {
+			dev_err(priv->dev, "failed to enable parent clock: %d\n", ret);
+			goto err_assert_cfg;
+		}
+	}
+
+	/* 3. Enable interconnect bus clock (allows host to access TCM/SRAM) */
+	/* 3. Enable bus clock */
+	if (priv->clk_bus) {
+		ret = clk_prepare_enable(priv->clk_bus);
+		if (ret) {
+			dev_err(priv->dev, "failed to enable bus clock: %d\n", ret);
+			goto err_disable_parent;
+		}
+	}
+
+	/* 4. Initialize MCU CCU Bus Bridges and hold core in reset */
+	if (priv->cfg_va) {
+		writel(0x00010001, priv->cfg_va + 0x108); /* TZMA0 */
+		writel(0x00010001, priv->cfg_va + 0x10c); /* TZMA1 */
+		writel(0x00010001, priv->cfg_va + 0x114); /* PubSRAM Gate */
+		writel(0x00000003, priv->cfg_va + 0x11c); /* MBUS Subsystem */
+		writel(0x80000000, priv->cfg_va + 0x120); /* RISCV_CLK */
+		writel(0x00010001, priv->cfg_va + 0x128); /* MSGBOX Mailbox */
+		writel(0x00030001, priv->cfg_va + 0x124); /* Hold Core in Reset */
+	}
+
+	return 0;
+
+err_disable_parent:
+	if (priv->clk_parent)
+		clk_disable_unprepare(priv->clk_parent);
+err_assert_cfg:
+	if (priv->rst_cfg)
+		reset_control_assert(priv->rst_cfg);
+	return ret;
+}
+
+static int sunxi_rproc_unprepare(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	/* Symmetrical CCU unwinding */
+	if (priv->clk_bus)
+		clk_disable_unprepare(priv->clk_bus);
+
+	if (priv->clk_parent)
+		clk_disable_unprepare(priv->clk_parent);
+
+	if (priv->rst_cfg)
+		reset_control_assert(priv->rst_cfg);
+
+	return 0;
+}
+
+static int sunxi_rproc_start(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+	int ret;
+
+	dev_info(priv->dev, "Starting XuanTie RISC-V core at entry 0x%llx\n", (u64)rproc->bootaddr);
+
+	if (rproc->bootaddr > U32_MAX)
+		return -EINVAL;
+
+	/* 1. Enable core clock to begin execution */
+	if (priv->clk_core) {
+		ret = clk_prepare_enable(priv->clk_core);
+		if (ret) {
+			dev_err(priv->dev, "failed to enable core clock: %d\n", ret);
+			return ret;
+		}
+	}
+
+	/* 3. Release XuanTie E907 Core Reset */
+	if (priv->cfg_va) {
+		writel(0x00070001, priv->cfg_va + 0x124);
+	}
+
+	return 0;
+}
+
+static int sunxi_rproc_stop(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	dev_info(priv->dev, "Halting XuanTie RISC-V core...\n");
+
+	if (priv->clk_core)
+		clk_disable_unprepare(priv->clk_core);
+
+	/* Hold XuanTie E907 Core in Reset */
+	if (priv->cfg_va)
+		writel(0x00030001, priv->cfg_va + 0x124);
+
+	return 0;
+}
+
+static void sunxi_rproc_kick(struct rproc *rproc, int vqid)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+	int ret;
+
+	if (!priv->tx_chan)
+		return;
+
+	ret = mbox_send_message(priv->tx_chan, (void *)&vqid);
+	if (ret < 0)
+		dev_err_ratelimited(priv->dev, "failed to send mailbox kick: %d\n", ret);
+}
+
+static void *sunxi_rproc_da_to_va(struct rproc *rproc, u64 da, size_t len, bool *is_iomem)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	if (is_iomem)
+		*is_iomem = true;
+
+	/* 1. Dedicated RISC-V SRAM (0x00000000 - 0x0003ffff) */
+	if (priv->r_sram_va) {
+		if (da >= priv->r_sram_phys && (da + len) <= (priv->r_sram_phys + priv->r_sram_size))
+			return priv->r_sram_va + (da - priv->r_sram_phys);
+		if (da < priv->r_sram_size && (da + len) <= priv->r_sram_size)
+			return priv->r_sram_va + da;
+	}
+
+	/* 2. Shared System SRAM (SRAM A2 0x00040000 - 0x00068000) */
+	if (priv->sram_va) {
+		if (da >= priv->sram_phys && (da + len) <= (priv->sram_phys + priv->sram_size))
+			return priv->sram_va + (da - priv->sram_phys);
+	}
+
+	/* 2. Instruction TCM */
+	if (priv->itcm_va) {
+		if (da >= priv->itcm_phys && (da + len) <= (priv->itcm_phys + priv->itcm_size))
+			return priv->itcm_va + (da - priv->itcm_phys);
+		if (da >= E907_ITCM_DA && (da + len) <= (E907_ITCM_DA + priv->itcm_size))
+			return priv->itcm_va + (da - E907_ITCM_DA);
+	}
+
+	/* 3. Data TCM */
+	if (priv->dtcm_va) {
+		if (da >= priv->dtcm_phys && (da + len) <= (priv->dtcm_phys + priv->dtcm_size))
+			return priv->dtcm_va + (da - priv->dtcm_phys);
+		if (da >= E907_DTCM_DA && (da + len) <= (E907_DTCM_DA + priv->dtcm_size))
+			return priv->dtcm_va + (da - E907_DTCM_DA);
+	}
+
+	return NULL;
+}
+
+static int sunxi_rproc_parse_fw(struct rproc *rproc, const struct firmware *fw)
+{
+	int ret = rproc_elf_load_rsc_table(rproc, fw);
+	if (ret == -EINVAL) {
+		dev_dbg(rproc->dev.parent, "no resource table found in ELF\n");
+		return 0;
+	}
+	return ret;
+}
+
+static const struct rproc_ops sunxi_rproc_ops = {
+	.prepare        = sunxi_rproc_prepare,
+	.unprepare      = sunxi_rproc_unprepare,
+	.start          = sunxi_rproc_start,
+	.stop           = sunxi_rproc_stop,
+	.kick           = sunxi_rproc_kick,
+	.da_to_va       = sunxi_rproc_da_to_va,
+	.get_boot_addr  = rproc_elf_get_boot_addr,
+	.load           = rproc_elf_load_segments,
+	.parse_fw       = sunxi_rproc_parse_fw,
+	.sanity_check   = rproc_elf_sanity_check,
+	.coredump       = rproc_coredump,
+};
+
+static int sunxi_rproc_register_mem(struct platform_device *pdev, struct rproc *rproc)
+{
+	struct device *dev = &pdev->dev;
+	struct sunxi_rproc *priv = rproc->priv;
+	struct resource *res;
+
+	/* 1. Map RISC-V CFG Block ("cfg") */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "cfg");
+	if (res) {
+		priv->cfg_va = devm_ioremap(dev, res->start, resource_size(res));
+		if (!priv->cfg_va)
+			dev_warn(dev, "failed to map 'cfg' registers; bootaddr write will be skipped\n");
+	}
+
+	/* 2. Map Dedicated RISC-V Local SRAM ("r_sram") */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "r_sram");
+	if (res) {
+		priv->r_sram_phys = res->start;
+		priv->r_sram_size = resource_size(res);
+		priv->r_sram_va = devm_ioremap_wc(dev, res->start, resource_size(res));
+		if (!priv->r_sram_va)
+			return -ENOMEM;
+	}
+
+	/* 3. Map Instruction TCM ("itcm") - Optional */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "itcm");
+	if (res) {
+		priv->itcm_phys = res->start;
+		priv->itcm_size = resource_size(res);
+		priv->itcm_va = devm_ioremap_wc(dev, res->start, resource_size(res));
+		if (!priv->itcm_va)
+			dev_warn(dev, "failed to map 'itcm' resource\n");
+	}
+
+	/* 4. Map Data TCM ("dtcm") - Optional */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dtcm");
+	if (res) {
+		priv->dtcm_phys = res->start;
+		priv->dtcm_size = resource_size(res);
+		priv->dtcm_va = devm_ioremap_wc(dev, res->start, resource_size(res));
+		if (!priv->dtcm_va)
+			dev_warn(dev, "failed to map 'dtcm' resource\n");
+	}
+
+	/* 5. Map Shared System SRAM A2 / C ("sram") */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sram");
+	if (res) {
+		priv->sram_phys = res->start;
+		priv->sram_size = resource_size(res);
+		priv->sram_va = devm_ioremap_wc(dev, res->start, resource_size(res));
+		if (!priv->sram_va)
+			dev_err(dev, "failed to map 'sram' resource\n");
+		else
+			dev_info(dev, "mapped sram %pad+%zx to %p\n", &priv->sram_phys, priv->sram_size, priv->sram_va);
+	}
+
+	return 0;
+}
+
+static int sunxi_rproc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	const char *fw_name = "riscv-firmware.elf";
+	struct sunxi_rproc *priv;
+	struct rproc *rproc;
+	int crash_irq;
+	int ret;
+
+	of_property_read_string(dev->of_node, "firmware-name", &fw_name);
+
+	rproc = devm_rproc_alloc(dev, dev_name(dev), &sunxi_rproc_ops,
+				 fw_name, sizeof(*priv));
+	if (!rproc) {
+		dev_err(dev, "failed to allocate rproc context\n");
+		return -ENOMEM;
+	}
+
+	priv = rproc->priv;
+	priv->rproc = rproc;
+	priv->dev = dev;
+
+	/* 1. Common Clock Framework (CCF) Clocks */
+	priv->clk_parent = devm_clk_get_optional(dev, "parent");
+	if (IS_ERR(priv->clk_parent))
+		return dev_err_probe(dev, PTR_ERR(priv->clk_parent), "failed to get 'parent' clock\n");
+
+	priv->clk_bus = devm_clk_get_optional(dev, "bus");
+	if (IS_ERR(priv->clk_bus))
+		return dev_err_probe(dev, PTR_ERR(priv->clk_bus), "failed to get 'bus' clock\n");
+
+	priv->clk_core = devm_clk_get_optional(dev, "core");
+	if (IS_ERR(priv->clk_core))
+		return dev_err_probe(dev, PTR_ERR(priv->clk_core), "failed to get 'core' clock\n");
+
+	/* 2. Resets */
+	priv->rst_core = devm_reset_control_get_optional_exclusive(dev, "core");
+	if (IS_ERR(priv->rst_core))
+		return dev_err_probe(dev, PTR_ERR(priv->rst_core), "failed to get 'core' reset\n");
+
+	priv->rst_cfg = devm_reset_control_get_optional_exclusive(dev, "cfg");
+	if (IS_ERR(priv->rst_cfg))
+		return dev_err_probe(dev, PTR_ERR(priv->rst_cfg), "failed to get 'cfg' reset\n");
+
+	priv->rst_module = devm_reset_control_get_optional_exclusive(dev, "module");
+	if (IS_ERR(priv->rst_module))
+		return dev_err_probe(dev, PTR_ERR(priv->rst_module), "failed to get 'module' reset\n");
+
+	/* 3. Memory Windows (TCM, SRAM, CFG) */
+	ret = sunxi_rproc_register_mem(pdev, rproc);
+	if (ret)
+		return ret;
+
+	/* 4. Optional Hardware Crash Notification IRQ */
+	crash_irq = platform_get_irq_byname_optional(pdev, "crash");
+	if (crash_irq > 0) {
+		ret = devm_request_threaded_irq(dev, crash_irq, NULL,
+						sunxi_rproc_crash_handler,
+						IRQF_ONESHOT, "sunxi-rproc-crash",
+						rproc);
+		if (ret)
+			dev_warn(dev, "failed to request crash IRQ %d: %d\n", crash_irq, ret);
+	}
+
+	/* 5. Mailbox IPC Client */
+	priv->cl.dev = dev;
+	priv->cl.rx_callback = sunxi_rproc_mb_rx_callback;
+	priv->cl.tx_block = false;
+	priv->cl.knows_txdone = false;
+
+	priv->tx_chan = mbox_request_channel_byname(&priv->cl, "tx");
+	if (IS_ERR(priv->tx_chan)) {
+		if (PTR_ERR(priv->tx_chan) == -EPROBE_DEFER) {
+			ret = -EPROBE_DEFER;
+			goto err_mem_release;
+		}
+		dev_info(dev, "no mailbox channel configured; running standalone mode\n");
+		priv->tx_chan = NULL;
+	}
+
+	platform_set_drvdata(pdev, rproc);
+
+	ret = rproc_add(rproc);
+	if (ret) {
+		dev_err(dev, "failed to register rproc device: %d\n", ret);
+		goto err_mbox_release;
+	}
+
+	dev_info(dev, "Allwinner XuanTie RISC-V remoteproc registered (%s)\n", fw_name);
+	return 0;
+
+err_mbox_release:
+	if (priv->tx_chan)
+		mbox_free_channel(priv->tx_chan);
+err_mem_release:
+	return ret;
+}
+
+static void sunxi_rproc_remove(struct platform_device *pdev)
+{
+	struct rproc *rproc = platform_get_drvdata(pdev);
+	struct sunxi_rproc *priv = rproc->priv;
+
+	rproc_del(rproc);
+
+	if (priv->tx_chan)
+		mbox_free_channel(priv->tx_chan);
+
+}
+
+static const struct of_device_id sunxi_rproc_of_match[] = {
+	{ .compatible = "allwinner,sun55i-a523-rproc" },
+	{ .compatible = "allwinner,sun60i-a733-rproc" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sunxi_rproc_of_match);
+
+static struct platform_driver sunxi_rproc_driver = {
+	.probe = sunxi_rproc_probe,
+	.remove = sunxi_rproc_remove,
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = sunxi_rproc_of_match,
+	},
+};
+module_platform_driver(sunxi_rproc_driver);
+
+MODULE_AUTHOR("Allwinner Technology Co., Ltd.");
+MODULE_AUTHOR("Tim Michals <tcmichals@gmail.com>");
+MODULE_DESCRIPTION("Allwinner XuanTie E907/E902 RISC-V Remoteproc Driver");
+MODULE_LICENSE("GPL");
