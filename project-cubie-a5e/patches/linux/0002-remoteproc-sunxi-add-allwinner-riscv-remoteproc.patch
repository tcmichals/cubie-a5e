From: Tim Michals <tcmichals@gmail.com>
Date: Fri, 21 Aug 2026 12:00:00 +0000
Subject: [PATCH] remoteproc: sunxi: add allwinner riscv remoteproc driver

---
 drivers/remoteproc/Kconfig       |   9 +
 drivers/remoteproc/Makefile      |   1 +
 drivers/remoteproc/sunxi_rproc.c | 270 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 280 insertions(+)
 create mode 100644 drivers/remoteproc/sunxi_rproc.c

--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -381,5 +381,14 @@ config XLNX_R5_REMOTEPROC
 	  It's safe to say N if not interested in using RPU r5f cores.
 
+config SUNXI_REMOTEPROC
+	tristate "Allwinner XuanTie RISC-V remoteproc support"
+	depends on (ARCH_SUNXI || COMPILE_TEST)
+	default y
+	help
+	  Say y or m here to support the Allwinner XuanTie E907/E902 RISC-V
+	  co-processor on Allwinner A523, A527, T527, and A733 SoCs via the
+	  remote processor framework.
+
 endif # REMOTEPROC
 
 endmenu
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -40,3 +40,4 @@
 obj-$(CONFIG_TI_K3_M4_REMOTEPROC)	+= ti_k3_m4_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_TI_K3_R5_REMOTEPROC)	+= ti_k3_r5_remoteproc.o ti_k3_common.o
 obj-$(CONFIG_XLNX_R5_REMOTEPROC)	+= xlnx_r5_remoteproc.o
+obj-$(CONFIG_SUNXI_REMOTEPROC)		+= sunxi_rproc.o
--- /dev/null
+++ b/drivers/remoteproc/sunxi_rproc.c
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Allwinner XuanTie E907/E902 RISC-V Remote Processor Driver
+ *
+ * Copyright (C) 2024-2026 Allwinner Technology Co., Ltd.
+ * Copyright (C) 2026 Tim Michals <tcmichals@gmail.com>
+ *
+ * Pure Device Tree driven remoteproc driver for XuanTie RISC-V co-processors
+ * on Allwinner SoCs (A523, A527, T527, A733).
+ *
+ * All hardware MMIO windows (Main CCU, MCU CCU, Dedicated RISC-V SRAM, and Shared SRAM)
+ * are retrieved dynamically from the Device Tree node resources:
+ *   - "main_ccu" : Main SoC CCU register window (CLK_DSP root parent clock @ 0x0c70)
+ *   - "ccu"      : MCU Subsystem CCU & Reset register window
+ *   - "r_sram"   : Dedicated Zero-Wait-State RISC-V Local SRAM (e.g. 0x07280000, 256 KB)
+ *   - "sram"     : Shared System SRAM C (e.g. 0x00020000, 128 KB)
+ */
+
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/remoteproc.h>
+
+#include "remoteproc_internal.h"
+
+#define DRIVER_NAME "sunxi-rproc"
+
+/* Main SoC CCU Relative Register Offsets */
+#define MAIN_CCU_CLK_DSP_REG  0x0c70
+#define MAIN_CCU_CLK_DSP_EN   0x80000000
+
+/* MCU Subsystem CCU Relative Register Offsets */
+#define MCU_CCU_TZMA0_REG     0x0108
+#define MCU_CCU_TZMA1_REG     0x010c
+#define MCU_CCU_PUBSRAM_REG   0x0114
+#define MCU_CCU_MBUS_REG      0x011c
+#define MCU_CCU_RISCV_CLK_REG 0x0120
+#define MCU_CCU_RISCV_RST_REG 0x0124
+#define MCU_CCU_MSGBOX_REG    0x0128
+
+/* Clock & Reset Control Values */
+#define MCU_TZMA0_ENABLE      0x00010001
+#define MCU_TZMA1_ENABLE      0x00010001
+#define MCU_PUBSRAM_ENABLE    0x00010001
+#define MCU_MBUS_ENABLE       0x00000003
+#define MCU_RISCV_CLK_ENABLE  0x80000000
+#define MCU_RISCV_CORE_BOOT   0x00070001
+#define MCU_RISCV_CORE_HOLD   0x00030001
+#define MCU_MSGBOX_ENABLE     0x00010001
+
+struct sunxi_rproc {
+	struct rproc *rproc;
+	struct device *dev;
+	void __iomem *main_ccu_va;
+	void __iomem *ccu_va;
+	void __iomem *r_sram_va;
+	void __iomem *sram_va;
+	phys_addr_t r_sram_phys;
+	size_t r_sram_size;
+	phys_addr_t sram_phys;
+	size_t sram_size;
+};
+
+static int sunxi_rproc_prepare(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	dev_info(priv->dev, "Preparing clocks and bus bridges for firmware loading...\n");
+
+	/* 1. Enable Main SoC CCU Root Parent Clock (CLK_DSP at offset 0x0c70) */
+	if (priv->main_ccu_va)
+		writel(MAIN_CCU_CLK_DSP_EN, priv->main_ccu_va + MAIN_CCU_CLK_DSP_REG);
+
+	/* 2. Enable MCU CCU TZMA Bridges, PubSRAM, MBUS, RISC-V Clock, and Mailbox */
+	if (priv->ccu_va) {
+		writel(MCU_TZMA0_ENABLE, priv->ccu_va + MCU_CCU_TZMA0_REG);
+		writel(MCU_TZMA1_ENABLE, priv->ccu_va + MCU_CCU_TZMA1_REG);
+		writel(MCU_PUBSRAM_ENABLE, priv->ccu_va + MCU_CCU_PUBSRAM_REG);
+		writel(MCU_MBUS_ENABLE, priv->ccu_va + MCU_CCU_MBUS_REG);
+		writel(MCU_RISCV_CLK_ENABLE, priv->ccu_va + MCU_CCU_RISCV_CLK_REG);
+		writel(MCU_MSGBOX_ENABLE, priv->ccu_va + MCU_CCU_MSGBOX_REG);
+
+		/* 3. Hold core in reset while ELF segments are loaded into SRAM */
+		writel(MCU_RISCV_CORE_HOLD, priv->ccu_va + MCU_CCU_RISCV_RST_REG);
+	}
+
+	return 0;
+}
+
+static int sunxi_rproc_start(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	dev_info(priv->dev, "Starting XuanTie RISC-V co-processor...\n");
+
+	/* Release Core Reset (0x00070001: deassert CORE, CFG, DEBUG resets) */
+	if (priv->ccu_va)
+		writel(MCU_RISCV_CORE_BOOT, priv->ccu_va + MCU_CCU_RISCV_RST_REG);
+
+	dev_info(priv->dev, "RISC-V core released from reset successfully\n");
+	return 0;
+}
+
+static int sunxi_rproc_stop(struct rproc *rproc)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	dev_info(priv->dev, "Halting XuanTie RISC-V co-processor...\n");
+
+	/* Hold core in reset (0x00030001) */
+	if (priv->ccu_va)
+		writel(MCU_RISCV_CORE_HOLD, priv->ccu_va + MCU_CCU_RISCV_RST_REG);
+
+	dev_info(priv->dev, "RISC-V core is held in reset\n");
+	return 0;
+}
+
+static void *sunxi_rproc_da_to_va(struct rproc *rproc, u64 da, size_t len, bool *is_iomem)
+{
+	struct sunxi_rproc *priv = rproc->priv;
+
+	if (is_iomem)
+		*is_iomem = true;
+
+	/* 1. Shared System SRAM C (Resource "sram") for telemetry and trace0 */
+	if (priv->sram_va) {
+		if (da >= priv->sram_phys && (da + len) <= (priv->sram_phys + priv->sram_size))
+			return priv->sram_va + (da - priv->sram_phys);
+	}
+
+	/* 2. Dedicated RISC-V Local SRAM (Resource "r_sram") */
+	if (priv->r_sram_va) {
+		if (da >= priv->r_sram_phys && (da + len) <= (priv->r_sram_phys + priv->r_sram_size))
+			return priv->r_sram_va + (da - priv->r_sram_phys);
+		if (da < priv->r_sram_size && (da + len) <= priv->r_sram_size)
+			return priv->r_sram_va + da;
+	}
+
+	dev_warn(priv->dev, "da_to_va: unmapped device address 0x%llx (len %zu)\n", da, len);
+	return NULL;
+}
+
+static int sunxi_rproc_parse_fw(struct rproc *rproc, const struct firmware *fw)
+{
+	int ret = rproc_elf_load_rsc_table(rproc, fw);
+	if (ret == -EINVAL) {
+		dev_info(rproc->dev.parent, "No resource table found; running bare-metal ELF\n");
+		return 0;
+	}
+	return ret;
+}
+
+static const struct rproc_ops sunxi_rproc_ops = {
+	.prepare	= sunxi_rproc_prepare,
+	.start		= sunxi_rproc_start,
+	.stop		= sunxi_rproc_stop,
+	.da_to_va	= sunxi_rproc_da_to_va,
+	.get_boot_addr	= rproc_elf_get_boot_addr,
+	.load		= rproc_elf_load_segments,
+	.parse_fw	= sunxi_rproc_parse_fw,
+	.sanity_check	= rproc_elf_sanity_check,
+};
+
+static int sunxi_rproc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	const char *fw_name = "riscv-firmware.elf";
+	struct sunxi_rproc *priv;
+	struct rproc *rproc;
+	struct resource *res;
+	int ret;
+
+	/* Dynamic firmware name override from Device Tree */
+	of_property_read_string(dev->of_node, "firmware-name", &fw_name);
+
+	rproc = devm_rproc_alloc(dev, dev_name(dev), &sunxi_rproc_ops,
+				 fw_name, sizeof(*priv));
+	if (!rproc) {
+		dev_err(dev, "failed to allocate rproc\n");
+		return -ENOMEM;
+	}
+
+	priv = rproc->priv;
+	priv->rproc = rproc;
+	priv->dev = dev;
+
+	/* 1. Map Main SoC CCU (Resource "main_ccu" for CLK_DSP parent clock) */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "main_ccu");
+	if (res) {
+		priv->main_ccu_va = devm_ioremap(dev, res->start, resource_size(res));
+		if (!priv->main_ccu_va)
+			dev_warn(dev, "failed to map main_ccu resource\n");
+	}
+
+	/* 2. Map MCU Subsystem CCU (Resource "ccu") */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ccu");
+	if (!res) {
+		dev_err(dev, "missing required 'ccu' memory resource in device tree\n");
+		return -EINVAL;
+	}
+	priv->ccu_va = devm_ioremap(dev, res->start, resource_size(res));
+	if (!priv->ccu_va) {
+		dev_err(dev, "failed to map 'ccu' memory resource\n");
+		return -ENOMEM;
+	}
+
+	/* 3. Map Dedicated RISC-V Local SRAM (Resource "r_sram") */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "r_sram");
+	if (!res) {
+		dev_err(dev, "missing required 'r_sram' memory resource in device tree\n");
+		return -EINVAL;
+	}
+	priv->r_sram_phys = res->start;
+	priv->r_sram_size = resource_size(res);
+	priv->r_sram_va = devm_ioremap(dev, res->start, resource_size(res));
+	if (!priv->r_sram_va) {
+		dev_err(dev, "failed to map 'r_sram' memory resource\n");
+		return -ENOMEM;
+	}
+
+	/* 4. Map Shared System SRAM C (Resource "sram") */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sram");
+	if (!res) {
+		dev_err(dev, "missing required 'sram' memory resource in device tree\n");
+		return -EINVAL;
+	}
+	priv->sram_phys = res->start;
+	priv->sram_size = resource_size(res);
+	priv->sram_va = devm_ioremap(dev, res->start, resource_size(res));
+	if (!priv->sram_va) {
+		dev_err(dev, "failed to map 'sram' memory resource\n");
+		return -ENOMEM;
+	}
+
+	platform_set_drvdata(pdev, rproc);
+
+	ret = devm_rproc_add(dev, rproc);
+	if (ret) {
+		dev_err(dev, "failed to add rproc device: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(dev, "Allwinner XuanTie RISC-V Remote Processor (%s) registered successfully\n", fw_name);
+	return 0;
+}
+
+static const struct of_device_id sunxi_rproc_of_match[] = {
+	{ .compatible = "allwinner,sun55i-a523-rproc" },
+	{ .compatible = "allwinner,sun55i-a527-rproc" },
+	{ .compatible = "allwinner,sun60i-a733-rproc" },
+	{ .compatible = "allwinner,sunxi-rproc" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sunxi_rproc_of_match);
+
+static struct platform_driver sunxi_rproc_driver = {
+	.probe = sunxi_rproc_probe,
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = sunxi_rproc_of_match,
+	},
+};
+module_platform_driver(sunxi_rproc_driver);
+
+MODULE_AUTHOR("Allwinner Technology Co., Ltd.");
+MODULE_AUTHOR("Tim Michals <tcmichals@gmail.com>");
+MODULE_DESCRIPTION("Allwinner XuanTie E907/E902 RISC-V Remoteproc Driver");
+MODULE_LICENSE("GPL");
-- 
2.43.0
