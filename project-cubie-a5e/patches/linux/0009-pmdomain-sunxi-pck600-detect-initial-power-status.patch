From: Tim Michals <tcmichals@gmail.com>
Subject: [PATCH] pmdomain: sunxi-pck600: properly manage power domain states

Initialize peripheral domains with is_off = true and configure CCU
resets and clocks on domain activation.

Signed-off-by: Tim Michals <tcmichals@gmail.com>
---
--- a/drivers/pmdomain/sunxi/sun55i-pck600.c
+++ b/drivers/pmdomain/sunxi/sun55i-pck600.c
@@ -89,8 +89,30 @@
 					FIELD_GET(PPU_PWR_STATUS, reg) == val,
 					0, 10000);
 	if (ret)
-		dev_err(pck->dev, "failed to turn domain \"%s\" %s: %d\n",
+		dev_err(pck ? pck->dev : NULL, "failed to turn domain \"%s\" %s: %d\n",
 			genpd->name, str_on_off(on), ret);
+
+	else {
+		dev_info(pck ? pck->dev : NULL, "turned domain \"%s\" %s (PWSR=0x%08x)\n",
+			 genpd->name, str_on_off(on), readl(pd->base + PPU_PWSR));
+		if (on && !strcmp(genpd->name, "USB2")) {
+			void __iomem *ccu_reg = ioremap(0x02002000, 0x2000);
+			void __iomem *dwc_test = ioremap(0x06A00000, 0x10000);
+			if (ccu_reg) {
+				writel(0x00030001, ccu_reg + 0x05A4);
+				writel(BIT(31) | BIT(16) | BIT(0), ccu_reg + 0x1340);
+				writel(BIT(16) | BIT(0), ccu_reg + 0x135C);
+				pr_info("sunxi-pck-600: CCU 0x05a4=%08x 0x1340=%08x 0x135c=%08x\n",
+					readl(ccu_reg + 0x05A4), readl(ccu_reg + 0x1340), readl(ccu_reg + 0x135C));
+				iounmap(ccu_reg);
+			}
+			if (dwc_test) {
+				pr_info("sunxi-pck-600: USB2 domain ON - 0x00=%08x 0xc100=%08x GSNPSID(0xc120)=%08x\n",
+					readl(dwc_test + 0x00), readl(dwc_test + 0xc100), readl(dwc_test + 0xc120));
+				iounmap(dwc_test);
+			}
+		}
+	}
 
 	return ret;
 }
@@ -165,13 +187,17 @@
 	for (i = 0; i < desc->num_domains; i++) {
 		struct sunxi_pck600_pd *pd = &pck->pds[i];
 
+		pd->pck = pck;
 		pd->genpd.name = desc->pd_names[i];
 		pd->genpd.power_off = sunxi_pck600_power_off;
 		pd->genpd.power_on = sunxi_pck600_power_on;
 		pd->base = base + PPU_REG_SIZE * i;
 
 		sunxi_pck600_pd_setup(pd, desc);
-		ret = pm_genpd_init(&pd->genpd, NULL, false);
+		dev_info(dev, "PD[%d] %s: base=%px PWSR=0x%08x PWPR=0x%08x\n",
+			 i, desc->pd_names[i], pd->base,
+			 readl(pd->base + PPU_PWSR), readl(pd->base + PPU_PWPR));
+		ret = pm_genpd_init(&pd->genpd, NULL, true);
 		if (ret) {
 			dev_err_probe(dev, ret, "failed to initialize power domain\n");
 			goto err_remove_pds;
