+	{ .fw_name = "losc" },
+	{ .fw_name = "hosc" },
+};
+static SUNXI_CCU_M_DATA_WITH_MUX(r_cpus_clk, "r-cpus", r_cpus_parents,
+				 0x000, 0, 5, 24, 2, 0);
+
+static const struct clk_hw *r_cpus_hws[] = {
+	&r_cpus_clk.common.hw
+};
+static SUNXI_CCU_M_HWS(r_ahb_clk, "r-ahb", r_cpus_hws, 0x004, 0, 5, 0);
+
+static const struct clk_hw *r_ahb_hws[] = {
+	&r_ahb_clk.common.hw
+};
+static SUNXI_CCU_M_HWS(r_apb1_clk, "r-apb1", r_ahb_hws, 0x00c, 0, 5, 0);
+
+static const struct clk_hw *r_apb1_hws[] = {
+	&r_apb1_clk.common.hw
+};
+
+static const struct clk_parent_data r_apb2_parents[] = {
+	{ .fw_name = "losc" },
+	{ .fw_name = "hosc" },
+};
+static SUNXI_CCU_M_DATA_WITH_MUX(r_apb2_clk, "r-apb2", r_apb2_parents,
+				 0x010, 0, 5, 24, 2, 0);
+
+static const struct clk_hw *r_apb2_hws[] = {
+	&r_apb2_clk.common.hw
+};
+
+static SUNXI_CCU_GATE_HWS(r_bus_uart0_clk, "r-bus-uart0", r_apb2_hws, 0x18c, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(r_bus_i2c0_clk,  "r-bus-i2c0",  r_apb2_hws, 0x19c, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(r_bus_i2c1_clk,  "r-bus-i2c1",  r_apb2_hws, 0x19c, BIT(1), 0);
+static SUNXI_CCU_GATE_HWS(r_bus_rtc_clk,    "r-bus-rtc",   r_apb1_hws, 0x20c, BIT(0), 0);
+
+static struct ccu_common *sun60i_a733_r_ccu_clks[] = {
+	&r_cpus_clk.common,
+	&r_ahb_clk.common,
+	&r_apb1_clk.common,
+	&r_apb2_clk.common,
+	&r_bus_uart0_clk.common,
+	&r_bus_i2c0_clk.common,
+	&r_bus_i2c1_clk.common,
+	&r_bus_rtc_clk.common,
+};
+
+static struct clk_hw_onecell_data sun60i_a733_r_hw_clks = {
+	.num = CLK_R_CPUCFG + 1,
+	.hws = {
+		[CLK_R_CPUS]		= &r_cpus_clk.common.hw,
+		[CLK_R_AHB]		= &r_ahb_clk.common.hw,
+		[CLK_R_APB1]		= &r_apb1_clk.common.hw,
+		[CLK_R_APB2]		= &r_apb2_clk.common.hw,
+		[CLK_R_BUS_UART0]	= &r_bus_uart0_clk.common.hw,
+		[CLK_R_BUS_I2C0]	= &r_bus_i2c0_clk.common.hw,
+		[CLK_R_BUS_I2C1]	= &r_bus_i2c1_clk.common.hw,
+		[CLK_R_BUS_RTC]		= &r_bus_rtc_clk.common.hw,
+	},
+};
+
+static const struct ccu_reset_map sun60i_a733_r_ccu_resets[] = {
+	[0] = { 0x18c, BIT(16) },
+	[1] = { 0x19c, BIT(16) },
+	[2] = { 0x19c, BIT(17) },
+};
+
+static const struct sunxi_ccu_desc sun60i_a733_r_ccu_desc = {
+	.ccu_clks	= sun60i_a733_r_ccu_clks,
+	.num_ccu_clks	= ARRAY_SIZE(sun60i_a733_r_ccu_clks),
+	.hw_clks	= &sun60i_a733_r_hw_clks,
+	.resets		= sun60i_a733_r_ccu_resets,
+	.num_resets	= ARRAY_SIZE(sun60i_a733_r_ccu_resets),
+};
+
+static int sun60i_a733_r_ccu_probe(struct platform_device *pdev)
+{
+	void __iomem *reg = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(reg))
+		return PTR_ERR(reg);
+	return devm_sunxi_ccu_probe(&pdev->dev, reg, &sun60i_a733_r_ccu_desc);
+}
+
+static const struct of_device_id sun60i_a733_r_ccu_ids[] = {
+	{ .compatible = "allwinner,sun60i-a733-r-ccu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_a733_r_ccu_ids);
+
+static struct platform_driver sun60i_a733_r_ccu_driver = {
+	.probe	= sun60i_a733_r_ccu_probe,
+	.driver	= {
+		.name			= "sun60i-a733-r-ccu",
+		.suppress_bind_attrs	= true,
+		.of_match_table		= sun60i_a733_r_ccu_ids,
+	},
+};
+module_platform_driver(sun60i_a733_r_ccu_driver);
+MODULE_LICENSE("GPL");
