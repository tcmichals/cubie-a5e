From: Tim Michals <tcmichals@gmail.com>
Subject: [PATCH] net: ethernet: stmmac: dwmac-sun55i: support A733 dedicated syscfg MMIO

On Allwinner A733 (sun60iw2), GMAC configuration registers (EMAC_CLK / EPIT / ETCS)
are located in dedicated per-GMAC memory resources (e.g. 0x04508000 for GMAC0)
rather than the global system control syscon block (0x03000034).

When no 'syscon' property is present, look up the dedicated 'syscfg' (or secondary)
MMIO resource and program the RGMII interface mode and clock delay parameters.

Signed-off-by: Tim Michals <tcmichals@gmail.com>
---
 drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c | 37 ++++++++++++++---
 1 file changed, 31 insertions(+), 6 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c
@@ -37,17 +37,32 @@
 #define SYSCON_ETCS_EXT_GMII	0x1
 #define SYSCON_ETCS_INT_GMII	0x2
 
-static int sun55i_gmac200_set_syscon(struct device *dev,
+static int sun55i_gmac200_set_syscon(struct platform_device *pdev,
 				     struct plat_stmmacenet_data *plat)
 {
+	struct device *dev = &pdev->dev;
 	struct device_node *node = dev->of_node;
-	struct regmap *regmap;
+	struct regmap *regmap = NULL;
+	void __iomem *syscfg_base = NULL;
+	struct resource *res;
 	u32 val, reg = 0;
 	int ret;
 
-	regmap = syscon_regmap_lookup_by_phandle(node, "syscon");
-	if (IS_ERR(regmap))
-		return dev_err_probe(dev, PTR_ERR(regmap), "Unable to map syscon\n");
+	if (of_property_present(node, "syscon")) {
+		regmap = syscon_regmap_lookup_by_phandle(node, "syscon");
+		if (IS_ERR(regmap))
+			return dev_err_probe(dev, PTR_ERR(regmap), "Unable to map syscon\n");
+	} else {
+		/* A733 / sun60i dedicated per-GMAC syscfg MMIO block */
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "syscfg");
+		if (!res)
+			res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+		if (!res)
+			return dev_err_probe(dev, -EINVAL, "No syscon or syscfg resource found\n");
+		syscfg_base = devm_ioremap_resource(dev, res);
+		if (IS_ERR(syscfg_base))
+			return PTR_ERR(syscfg_base);
+	}
 
 	if (!of_property_read_u32(node, "tx-internal-delay-ps", &val)) {
 		if (val % 100)
@@ -95,9 +110,13 @@
 				     phy_modes(plat->phy_interface));
 	}
 
-	ret = regmap_write(regmap, SYSCON_REG, reg);
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Failed to write to syscon\n");
+	if (syscfg_base) {
+		writel(reg, syscfg_base + 0x00);
+	} else {
+		ret = regmap_write(regmap, SYSCON_REG, reg);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "Failed to write to syscon\n");
+	}
 
 	return 0;
 }
@@ -122,7 +141,7 @@
 	plat_dat->flags |= STMMAC_FLAG_SPH_DISABLE;
 	plat_dat->host_dma_width = 32;
 
-	ret = sun55i_gmac200_set_syscon(dev, plat_dat);
+	ret = sun55i_gmac200_set_syscon(pdev, plat_dat);
 	if (ret)
 		return ret;
 
@@ -140,6 +159,8 @@
 
 static const struct of_device_id sun55i_gmac200_match[] = {
 	{ .compatible = "allwinner,sun55i-a523-gmac200" },
+	{ .compatible = "allwinner,sun60i-a733-gmac210" },
+	{ .compatible = "allwinner,sunxi-gmac-210" },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, sun55i_gmac200_match);
-- 
2.34.1
