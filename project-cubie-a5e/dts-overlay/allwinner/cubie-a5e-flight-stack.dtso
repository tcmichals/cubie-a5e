/dts-v1/;
/plugin/;

/*
 * ============================================================================
 *                    RADXA CUBIE A5E — FLIGHT STACK OVERLAY
 * ============================================================================
 * Hardware Resource Partitioning:
 *  - RISC-V Co-Processor (XuanTie E907 Dedicated):
 *      * UART2 (Serial Console / CRSF / Telemetry) on Pins 11 & 13 (PB0/PB1)
 *      * SPI0 (Dual-SPI for FPGA @ CS0, Single-SPI for IMU @ CS1) on Pins 19, 21, 23, 24, 26 (Port C)
 *      * FPGA Frame Ready ISR (GPIO Input) on Pin 22
 *      * IMU Data Ready (DRDY) ISR (GPIO Input) on Pin 29
 *  - Linux Host (ARM Cortex-A55):
 *      * UART0 (Debug Console Terminal) on Pins 8 & 10 (PB9/PB10)
 *      * SPI1 (General Purpose Expansion SPI) on Pins 35, 38, 40, 12
 *      * SPI2 (General Purpose Expansion SPI) on Pins 7, 15, 16, 18
 *      * I2C1 (Expansion I2C) on Pins 3 & 5
 *      * I2C3 (Compass / Barometer) on Pins 27 & 28
 *
 * Physical 40-Pin Header Layout Mapping:
 * 
 *                  3.3V Power [ 1] [ 2] 5V Power (Input/Output)
 *            I2C1-SDA (TWI1)  [ 3] [ 4] 5V Power (Input/Output)
 *            I2C1-SCL (TWI1)  [ 5] [ 6] GND
 *            SPI2-CLK         [ 7] [ 8] UART0-TX (Linux Serial Console)
 *                         GND [ 9] [10] UART0-RX (Linux Serial Console)
 *   [RISC-V] UART2-TX (PB0)   [11] [12] SPI1-CS0 (Linux Expansion)
 *   [RISC-V] UART2-RX (PB1)   [13] [14] GND
 *            SPI2-CS0         [15] [16] SPI2-MOSI
 *                  3.3V Power [17] [18] SPI2-MISO
 *   [RISC-V] SPI0-MOSI / IO0  [19] [20] GND
 *   [RISC-V] SPI0-MISO / IO1  [21] [22] FPGA Frame Ready ISR (GPIO)   [RISC-V]
 *   [RISC-V] SPI0-CLK         [23] [24] SPI0-CS0 (FPGA Dual-SPI)      [RISC-V]
 *                         GND [25] [26] SPI0-CS1 (IMU Single-SPI)     [RISC-V]
 *            I2C3-SDA (TWI3)  [27] [28] I2C3-SCL (TWI3) (Sensors/Compass)
 *   [RISC-V] IMU DRDY ISR     [29] [30] GND
 *                        GPIO [31] [32] GPIO/PWM
 *                        GPIO [33] [34] GND
 *            SPI1-MISO (Exp)  [35] [36] GPIO
 *                        GPIO [37] [38] SPI1-MOSI (Exp)
 *                         GND [39] [40] SPI1-CLK  (Exp)
 * ============================================================================
 */

/* UART0: Debug Console Terminal for Linux Host (Pins 8 and 10) */
&uart0 {
    status = "okay";
};

/* UART2: Dedicated RISC-V Serial Port (Pins 11 and 13 - Disabled in Linux) */
&uart2 {
    status = "disabled";
};

/* SPI0: Dedicated RISC-V High-Speed Dual/Single Bus (Pins 19, 21, 23, 24, 26 - Disabled in Linux) */
&spi0 {
    status = "disabled";
};

&{/aliases} {
    serial0 = "/soc/serial@2500000";
    serial2 = "/soc/serial@2500800";
    mmc0 = "/soc/mmc@4020000";
    mmc1 = "/soc/mmc@4021000";
};

&{/} {
    cubie-flight-stack-version = "1.3";

    reg_wifi_en: wifi-en {
        compatible = "regulator-fixed";
        regulator-name = "wifi-en";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        /* PM1 (Bank 1, Pin 1, Active High). Drives WL_REG_ON high to enable Wi-Fi */
        gpio = <&r_pio 1 1 0>;
        enable-active-high;
        startup-delay-us = <1000000>; /* 1000ms delay to let the chip boot */
    };
};

/* Configure Port C (VCC-PC) and Port K (VCC-PK) IO rail to 3.3V for 40-pin header peripherals */
&reg_cldo1 {
    regulator-min-microvolt = <3300000>;
    regulator-max-microvolt = <3300000>;
};

&reg_bldo1 {
    regulator-always-on;
};

/* I2C1: General Expansion Bus (Enabled on physical pins 3 and 5) */
&i2c1 {
    status = "okay";
    pinctrl-names = "default";
};

/* I2C3: Barometer, Compass, and Flight Sensors (Enabled on physical pins 27 and 28) */
&i2c3 {
    status = "okay";
    pinctrl-names = "default";
};

/* SPI1: Linux General Purpose SPI Link (Enabled on physical pins 35, 38, 40, 12) */
&spi1 {
    status = "okay";
    pinctrl-names = "default";
    num-cs = <1>;
    
    /* User-space SPIDEV node (/dev/spidev1.0) */
    spidev1@0 {
        compatible = "rohm,dh2228fv";
        reg = <0>;
        spi-max-frequency = <25000000>;
        status = "okay";
    };
};

/* SPI2: General-Purpose SPI Expansion (Enabled on physical pins 7, 15, 16, 18) */
&spi2 {
    status = "okay";
    pinctrl-names = "default";
    num-cs = <1>;
    
    /* User-space SPIDEV node (/dev/spidev2.0) */
    spidev2@0 {
        compatible = "rohm,dh2228fv";
        reg = <0>;
        spi-max-frequency = <10000000>;
        status = "okay";
    };
};

&mmc1 {
    /* Enumerate the onboard AIC8800 SDIO WLAN device on MMC host 1 */
    bus-width = <4>;
    max-frequency = <25000000>;
    non-removable;
    keep-power-in-suspend;
    pinctrl-names = "default";
    pinctrl-0 = <&mmc1_pins>;
    vmmc-supply = <&reg_wifi_en>;
    vqmmc-supply = <&reg_bldo1>;
    status = "okay";

    wifi: wifi@1 {
        reg = <1>;
        compatible = "aic,aic8800";
        status = "okay";
    };
};

&{/} {
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        riscvsram0_reserved: riscvsram0@7280000 {
            reg = <0x0 0x07280000 0x0 0x40000>;
            no-map;
        };
    };
};

&msgbox {
    status = "okay";
};

&rproc {
    firmware-name = "riscv-firmware.elf";
    status = "okay";
};



