/dts-v1/;
/plugin/;

/*
 * ============================================================================
 *                    RADXA CUBIE A5E — FLIGHT STACK OVERLAY
 * ============================================================================
 * Hardware Resource Partitioning:
 *  - RISC-V Co-Processor (XuanTie E906 Dedicated):
 *      * UART2 (Serial Console / CRSF / Telemetry) on Pins 11 & 13 (PB0/PB1)
 *      * SPI0 (Dual-SPI for FPGA @ CS0, Single-SPI for IMU @ CS1) on Pins 19, 21, 23, 24, 26 (Port C)
 *      * FPGA Frame Ready ISR (GPIO Input) on Pin 22
 *      * IMU Data Ready (DRDY) ISR (GPIO Input) on Pin 29
 *  - Linux Host (ARM Cortex-A55):
 *      * UART0 (Debug Console Terminal) on Pins 8 & 10 (PB9/PB10)
 *      * SPI1 (General Purpose Expansion SPI) on Pins 35, 38, 40, 12
 *      * SPI2 (General Purpose Expansion SPI) on Pins 7, 15, 16, 18
 *      * I2C1 (Expansion I2C) on Pins 3 & 5
 *      * I2C3 (Compass / Barometer) on Pins 27 & 28
 *
 * Physical 40-Pin Header Layout Mapping (Verified against Radxa Cubie A5E Schematic v1.2):
 * 
 *                  3.3V Power [ 1] [ 2] 5V Power (Input/Output)
 *            I2C1-SDA (PB5)   [ 3] [ 4] 5V Power (Input/Output)
 *            I2C1-SCL (PB4)   [ 5] [ 6] GND
 *            SPI2-CLK (PI7)   [ 7] [ 8] UART0-TX (PB9 - Linux Serial Console)
 *                         GND [ 9] [10] UART0-RX (PB10 - Linux Serial Console)
 *            GPIO/PWM (PI9)   [11] [12] SPI1-CS0 (PI2 / Alternate)
 *            GPIO/PWM (PI10)  [13] [14] GND
 *            S-UART0-TX(PL12) [15] [16] UART3-TX (PI11 - GPS Serial RX)
 *                  3.3V Power [17] [18] GPIO/PWM (PI14)
 *   [Dual-SPI] SPI1-MOSI(PB13)[19] [20] GND
 *   [Dual-SPI] SPI1-MISO(PB14)[21] [22] FPGA Frame Ready ISR (PL13)
 *   [Dual-SPI] SPI1-CLK (PB12)[23] [24] SPI1-CS0 (PB11 - FPGA Chip Select)
 *                         GND [25] [26] UART4-TX / IMU-CS1 (PI0)
 *            I2C2-SDA (PI16)  [27] [28] I2C2-SCK (PI15)
 *            IMU DRDY (PI8)   [29] [30] GND
 *            UART3-RX (PI12)  [31] [32] UART4-RX (PI1)
 *            SPI2-CS0 (PI6)   [33] [34] GND
 *            GPIO     (PI13)  [35] [36] SPI1-CLK (PI3)
 *            GPADC2           [37] [38] SPI1-MISO (PI5)
 *                         GND [39] [40] SPI1-MOSI (PI4)
 * ============================================================================
 */

/* UART0: Debug Console Terminal for Linux Host (Pins 8 and 10) */
&uart0 {
    status = "okay";
};

/* UART3: High-Speed Navigation Serial Port for GPS (Pins 16 and 31) */
&uart3 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart3_pi_pins>;
    status = "okay";
};

/* UART4: Alternate Serial Port (Pins 26 and 32) */
&uart4 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart4_pi_pins>;
    status = "okay";
};

/* SPI0: Port C unrouted on 40-pin header - Disabled in Linux */
&spi0 {
    status = "disabled";
};

&{/aliases} {
    ethernet0 = "/soc/ethernet@4500000";
    ethernet1 = "/soc/ethernet@4510000";
    serial0 = "/soc/serial@2500000";
    serial3 = "/soc/serial@2500c00";
    serial4 = "/soc/serial@2501000";
    i2c1 = "/soc/i2c@2502400";
    spi1 = "/soc/spi@4026000";
    mmc0 = "/soc/mmc@4020000";
    mmc1 = "/soc/mmc@4021000";
};

&{/} {
    #address-cells = <2>;
    #size-cells = <2>;
    ranges;
    cubie-flight-stack-version = "1.5";

    /* PL7 (Bank 0, Pin 7, Active High): Hardware 3.3V Power Switch for AIC8800 Wi-Fi/BT */
    reg_3v3_wifi: 3v3-wifi {
        compatible = "regulator-fixed";
        regulator-name = "3v3-wifi";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        gpio = <&r_pio 0 7 0>;
        enable-active-high;
        regulator-always-on;
    };

    /* PM1 (Bank 1, Pin 1, Active High): Hardware Enable / WL_REG_ON */
    reg_wifi_en: wifi-en {
        compatible = "regulator-fixed";
        regulator-name = "wifi-en";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        gpio = <&r_pio 1 1 0>;
        enable-active-high;
        regulator-always-on;
        startup-delay-us = <100000>;
    };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        riscvsram0_reserved: riscvsram0@7280000 {
            reg = <0x0 0x07280000 0x0 0x40000>;
            no-map;
        };

        /* Virtio vrings and buffers: DMA pool for the remoteproc device */
        rproc_vdev: vdev@48000000 {
            compatible = "shared-dma-pool";
            reg = <0x0 0x48000000 0x0 0x00100000>;
            no-map;
        };

        /* E906 firmware DRAM (e906_ddr.ld, testDRAMMsg payload pool) */
        rproc_dram: dram@48100000 {
            reg = <0x0 0x48100000 0x0 0x00100000>;
            no-map;
        };
    };
};

/* Configure Port C (VCC-PC) and Port K (VCC-PK) IO rail to 3.3V for 40-pin header peripherals */
&reg_cldo1 {
    regulator-min-microvolt = <3300000>;
    regulator-max-microvolt = <3300000>;
    regulator-always-on;
};

&reg_bldo1 {
    regulator-always-on;
};

/* Pinmux Controller Configurations for 40-Pin Header */
&pio {
    i2c1_pb_pins: i2c1-pb-pins {
        pins = "PB4", "PB5";
        function = "i2c1";
        bias-pull-up;
    };

    uart3_pi_pins: uart3-pi-pins {
        pins = "PI11", "PI12";
        function = "uart3";
    };

    uart4_pi_pins: uart4-pi-pins {
        pins = "PI0", "PI1";
        function = "uart4";
    };

    spi1_pb_pins: spi1-pb-pins {
        pins = "PB11", "PB12", "PB13", "PB14";
        function = "spi1";
    };
};

/* I2C1: General Expansion Bus (Enabled on physical pins 3 and 5) */
&i2c1 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c1_pb_pins>;
    status = "okay";
};

/* SPI1: High-Speed Dual-SPI / Single-SPI Bus (Enabled on physical pins 24, 23, 19, 21) */
&spi1 {
    pinctrl-names = "default";
    pinctrl-0 = <&spi1_pb_pins>;
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    num-cs = <1>;
    
    /* User-space SPIDEV node (/dev/spidev1.0) */
    spidev1@0 {
        compatible = "rohm,dh2228fv";
        reg = <0>;
        spi-max-frequency = <25000000>;
        status = "okay";
    };
};

&mmc1 {
    /* Enumerate the onboard AIC8800 SDIO WLAN device on MMC host 1 */
    #address-cells = <1>;
    #size-cells = <0>;
    bus-width = <4>;
    max-frequency = <25000000>;
    non-removable;
    keep-power-in-suspend;
    pinctrl-names = "default";
    pinctrl-0 = <&mmc1_pins>;
    vmmc-supply = <&reg_3v3_wifi>;
    vqmmc-supply = <&reg_bldo1>;
    status = "okay";

    wifi: wifi@1 {
        reg = <1>;
        compatible = "aic,aic8800";
        status = "okay";
    };
};

&msgbox {
    status = "okay";
};

&rproc {
    firmware-name = "riscv-firmware.elf";
    memory-region = <&rproc_vdev>;
    status = "okay";
};



