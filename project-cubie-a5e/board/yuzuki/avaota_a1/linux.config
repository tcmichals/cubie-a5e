# Preempt-RT hard real-time scheduler
CONFIG_PREEMPT_RT=y

# High resolution timer and 1000Hz ticks for flight dynamics
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# XuanTie RISC-V RemoteProc & Mailbox Subsystem
CONFIG_MAILBOX=y
CONFIG_SUNXI_MSGBOX=y
CONFIG_REMOTEPROC=y
CONFIG_SUNXI_RPROC=y
CONFIG_SUNXI_REMOTEPROC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_VIRTIO=y

# Real-Time CPU Isolation & Core Pinning
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y

# Gigabit Ethernet
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN55I=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_REALTEK_PHY=y

# Etnaviv NPU DRM acceleration
CONFIG_DRM=y
CONFIG_DRM_ETNAVIV=y

# Userspace I/O and direct SPI/I2C
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
CONFIG_SPI_SPIDEV=y
CONFIG_I2C_CHARDEV=y

# Memory optimization
# CONFIG_NUMA is not set
CONFIG_ARM64_VA_BITS_48=y

# ==========================================
