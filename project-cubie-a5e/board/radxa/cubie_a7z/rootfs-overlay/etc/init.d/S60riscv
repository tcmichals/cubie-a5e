#!/bin/sh
#
# S60riscv: Startup initialization for XuanTie E907 RISC-V co-processor via Remoteproc
#

RPROC_STATE="/sys/class/remoteproc/remoteproc0/state"
RPROC_FIRMWARE="/sys/class/remoteproc/remoteproc0/firmware"

case "$1" in
    start)
        if [ -f "$RPROC_STATE" ]; then
            if [ -f /lib/firmware/riscv-firmware.elf ]; then
                echo "riscv-firmware.elf" > "$RPROC_FIRMWARE" 2>/dev/null || true
                echo "start" > "$RPROC_STATE" 2>/dev/null || true
                echo "Started XuanTie E907 RISC-V core via remoteproc"
            fi
        fi
        ;;
    stop)
        if [ -f "$RPROC_STATE" ]; then
            echo "stop" > "$RPROC_STATE" 2>/dev/null || true
            echo "Stopped XuanTie E907 RISC-V core"
        fi
        ;;
    restart|reload)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if [ -f "$RPROC_STATE" ]; then
            echo "Remoteproc State: $(cat "$RPROC_STATE")"
            echo "Remoteproc Firmware: $(cat "$RPROC_FIRMWARE" 2>/dev/null || echo 'unknown')"
        else
            echo "Remoteproc device not found"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
