From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Michals <tcmichals@gmail.com>
Date: Fri, 21 Aug 2026 22:45:00 -0500
Subject: [PATCH] radxa-cubie-a7a: page-align CONFIG_TEXT_BASE=0x4a001000 and enable DEBUG_UART

Align CONFIG_TEXT_BASE to a 4KB page boundary (0x4a001000) so that AArch64 adrp
page-relative addressing remains 100% aligned with 0 offset discrepancy when
relocating to page-aligned RAM.

---
 configs/radxa-cubie-a7a_defconfig | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/configs/radxa-cubie-a7a_defconfig b/configs/radxa-cubie-a7a_defconfig
index 1111111..2222222 100644
--- a/configs/radxa-cubie-a7a_defconfig
+++ b/configs/radxa-cubie-a7a_defconfig
@@ -1,5 +1,12 @@
 CONFIG_ARM=y
 CONFIG_ARCH_SUNXI=y
+CONFIG_TEXT_BASE=0x4a001000
+CONFIG_DEBUG_UART=y
+CONFIG_DEBUG_UART_NS16550=y
+CONFIG_DEBUG_UART_BASE=0x02500000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_DEBUG_UART_SHIFT=2
+CONFIG_DEBUG_UART_ANNOUNCE=y
 CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x4F000000
 CONFIG_DEFAULT_DEVICE_TREE="sun60i-a733-radxa-a7a"
-- 
2.44.0
