CONFIG_NET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_ARCH_SUNXI=y
CONFIG_SUNXI_CCU=y
CONFIG_SUN60I_A733_CCU=y
CONFIG_SUN60I_A733_R_CCU=y
CONFIG_PINCTRL_SUNXI=y
CONFIG_PINCTRL_SUN60I_A733=y
CONFIG_PINCTRL_SUN60I_A733_R=y
CONFIG_MMC_SUNXI=y
CONFIG_SERIAL_8250_SUNXI=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_NET_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_DWMAC_SUN55I=y
CONFIG_DWMAC_GENERIC=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_MAXIO_PHY=y
CONFIG_REALTEK_PHY=y

# USB Subsystem
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_SUN55I_PCK600=y

CONFIG_SPI_SUNXI=y
CONFIG_SPI_SPIDEV=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y

# Real-time validation baseline
CONFIG_EXPERT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
# CONFIG_NUMA is not set
CONFIG_NO_HZ_FULL=y
CONFIG_DRM=y
CONFIG_DRM_ETNAVIV=y
CONFIG_MAILBOX=y
CONFIG_SUN6I_MSGBOX=y
# Remoteproc / RPMsg disabled (E902 dedicated to U-Boot power management)
# CONFIG_REMOTEPROC is not set
# CONFIG_SUNXI_REMOTEPROC is not set
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_KUNIT=y
CONFIG_KUNIT_ALL_TESTS=n

# Userspace I/O (UIO) for Lite-libmetal Mailbox Doorbell & Real-time IPC
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y

