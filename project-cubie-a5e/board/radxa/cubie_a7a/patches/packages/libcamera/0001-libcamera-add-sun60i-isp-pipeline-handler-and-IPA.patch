+
+ipa_names += ipa_name
diff --git a/src/ipa/sun60i-isp/sun60i_isp.cpp b/src/ipa/sun60i-isp/sun60i_isp.cpp
new file mode 100644
index 0000000..4ceeabc
--- /dev/null
+++ b/src/ipa/sun60i-isp/sun60i_isp.cpp
@@ -0,0 +1,287 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Allwinner A733 / T527 Hardware ISP 602 IPA Module
+ */
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <vector>
+
+#include <linux/sun60i-isp-config.h>
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/span.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/ipa/ipa_interface.h>
+#include <libcamera/ipa/ipa_module_info.h>
+#include <libcamera/ipa/sun60i_isp_ipa_interface.h>
+
+#include "libcamera/internal/mapped_framebuffer.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASun60iIsp)
+
+namespace ipa::sun60i_isp {
+
+class IPASun60iIsp : public IPASun60iIspInterface
+{
+public:
+	IPASun60iIsp() = default;
+
+	int init(const IPASettings &settings, const IPAConfigInfo &configInfo,
+		 ControlInfoMap *ipaControls) override;
+	int start() override;
+	void stop() override;
+	int configure(const IPAConfigInfo &configInfo,
+		      ControlInfoMap *ipaControls) override;
+
+	void mapBuffers(const std::vector<IPABuffer> &buffers, bool readOnly) override;
+	void unmapBuffers(const std::vector<IPABuffer> &buffers) override;
+
+	void queueRequest(uint32_t request, const ControlList &reqControls) override;
+	void fillParams(uint32_t request, uint32_t bufferId) override;
+	void processStats(uint32_t request, uint32_t bufferId,
+			  const ControlList &sensorControls) override;
+
+private:
+	void updateControls(const IPAConfigInfo &configInfo,
+			    ControlInfoMap *ipaControls);
+
+	std::map<unsigned int, MappedFrameBuffer> buffers_;
+	ControlInfoMap sensorControls_;
+
+	int32_t minExposure_ = 4;
+	int32_t maxExposure_ = 1155;
+	int32_t exposure_ = 400;
+
+	int32_t minGain_ = 16;
+	int32_t maxGain_ = 256;
+	int32_t gain_ = 32;
+
+	bool aeEnable_ = true;
+	uint16_t wbR_ = 256;
+	uint16_t wbB_ = 256;
+
+	uint32_t frameCount_ = 0;
+	uint32_t aeBaseline_ = 0;
+};
+
+int IPASun60iIsp::init([[maybe_unused]] const IPASettings &settings,
+		       const IPAConfigInfo &configInfo,
+		       ControlInfoMap *ipaControls)
+{
+	updateControls(configInfo, ipaControls);
+	return 0;
+}
+
+int IPASun60iIsp::start()
+{
+	frameCount_ = 0;
+	return 0;
+}
+
+void IPASun60iIsp::stop()
+{
+}
+
+int IPASun60iIsp::configure(const IPAConfigInfo &configInfo,
+			    ControlInfoMap *ipaControls)
+{
+	updateControls(configInfo, ipaControls);
+	return 0;
+}
+
+void IPASun60iIsp::updateControls(const IPAConfigInfo &configInfo,
+				  ControlInfoMap *ipaControls)
+{
+	sensorControls_ = configInfo.sensorControls;
+	const auto &expIt = configInfo.sensorControls.find(V4L2_CID_EXPOSURE);
+	if (expIt != configInfo.sensorControls.end()) {
+		minExposure_ = expIt->second.min().get<int32_t>();
+		maxExposure_ = expIt->second.max().get<int32_t>();
+		exposure_ = std::clamp(expIt->second.def().get<int32_t>(),
+				       minExposure_, maxExposure_);
+	}
+
+	const auto &gainIt = configInfo.sensorControls.find(V4L2_CID_ANALOGUE_GAIN);
+	if (gainIt != configInfo.sensorControls.end()) {
+		minGain_ = gainIt->second.min().get<int32_t>();
+		maxGain_ = gainIt->second.max().get<int32_t>();
+		gain_ = std::clamp(gainIt->second.def().get<int32_t>(),
+				   minGain_, maxGain_);
+	}
+
+	ControlInfoMap::Map ctrlMap;
+	ctrlMap[&controls::AeEnable] = ControlInfo(false, true, true);
+	ctrlMap[&controls::ExposureTime] =
+		ControlInfo(minExposure_, maxExposure_, exposure_);
+	ctrlMap[&controls::AnalogueGain] =
+		ControlInfo(static_cast<float>(minGain_),
+			    static_cast<float>(maxGain_),
+			    static_cast<float>(gain_));
+	ctrlMap[&controls::ColourGains] = ControlInfo(0.5f, 4.0f, 1.0f);
+
+	*ipaControls = ControlInfoMap(std::move(ctrlMap), controls::controls);
+}
+
+void IPASun60iIsp::mapBuffers(const std::vector<IPABuffer> &buffers,
+			      [[maybe_unused]] bool readOnly)
+{
+	for (const IPABuffer &buffer : buffers) {
+		const FrameBuffer fb(buffer.planes);
+		buffers_.emplace(buffer.id,
+				 MappedFrameBuffer(&fb, MappedFrameBuffer::MapFlag::ReadWrite));
+	}
+}
+
+void IPASun60iIsp::unmapBuffers(const std::vector<IPABuffer> &buffers)
+{
+	for (const IPABuffer &buffer : buffers)
+		buffers_.erase(buffer.id);
+}
+
+void IPASun60iIsp::queueRequest([[maybe_unused]] uint32_t request,
+				const ControlList &reqControls)
+{
+	const auto &aeCtrl = reqControls.get(controls::AeEnable);
+	if (aeCtrl)
+		aeEnable_ = *aeCtrl;
+
+	if (!aeEnable_) {
+		const auto &expCtrl = reqControls.get(controls::ExposureTime);
+		if (expCtrl)
+			exposure_ = std::clamp(*expCtrl, minExposure_, maxExposure_);
+
+		const auto &gainCtrl = reqControls.get(controls::AnalogueGain);
+		if (gainCtrl)
+			gain_ = std::clamp(static_cast<int32_t>(*gainCtrl),
+					   minGain_, maxGain_);
+	}
+
+	const auto &cgCtrl = reqControls.get(controls::ColourGains);
+	if (cgCtrl) {
+		wbR_ = static_cast<uint16_t>(std::clamp((*cgCtrl)[0] * 256.0f, 128.0f, 1024.0f));
+		wbB_ = static_cast<uint16_t>(std::clamp((*cgCtrl)[1] * 256.0f, 128.0f, 1024.0f));
+	}
+}
+
+void IPASun60iIsp::fillParams(uint32_t request, uint32_t bufferId)
+{
+	auto it = buffers_.find(bufferId);
+	if (it == buffers_.end()) {
+		paramsComputed.emit(request, 0);
+		return;
+	}
+
+	auto *params = reinterpret_cast<struct sun60i_isp_params_cfg *>(
+		it->second.planes()[0].data());
+	std::memset(params, 0, sizeof(*params));
+
+	params->version = SUN60I_ISP_PARAM_API_V1;
+	params->module_en_update = SUN60I_ISP_MOD_WB;
+	params->module_ens = SUN60I_ISP_MOD_WB;
+	params->module_cfg_update = SUN60I_ISP_MOD_WB;
+	params->wb.r = wbR_;
+	params->wb.gr = 256;
+	params->wb.gb = 256;
+	params->wb.b = wbB_;
+
+	paramsComputed.emit(request, sizeof(*params));
+}
+
+void IPASun60iIsp::processStats(uint32_t request, uint32_t bufferId,
+				const ControlList &sensorControls)
+{
+	auto it = buffers_.find(bufferId);
+	if (it == buffers_.end()) {
+		ControlList empty(controls::controls);
+		statsProcessed.emit(request, empty);
+		return;
+	}
+
+	const auto *stats = reinterpret_cast<const struct sun60i_isp_stat_buffer *>(
+		it->second.planes()[0].data());
+
+	int32_t activeExp = (sensorControls.contains(V4L2_CID_EXPOSURE) &&
+			     !sensorControls.get(V4L2_CID_EXPOSURE).isNone())
+				    ? sensorControls.get(V4L2_CID_EXPOSURE).get<int32_t>()
+				    : exposure_;
+	int32_t activeGain = (sensorControls.contains(V4L2_CID_ANALOGUE_GAIN) &&
+			      !sensorControls.get(V4L2_CID_ANALOGUE_GAIN).isNone())
+				     ? sensorControls.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>()
+				     : gain_;
+
+	/* Compute mean AE luma from 432 u16 zones (SUN60I_ISP_STAT_AE_SIZE / 2) */
+	const auto *aeZones = reinterpret_cast<const uint16_t *>(stats->ae);
+	constexpr size_t kNumZones = SUN60I_ISP_STAT_AE_SIZE / sizeof(uint16_t);
+	uint64_t aeSum = 0;
+	for (size_t i = 0; i < kNumZones; i++)
+		aeSum += aeZones[i];
+	uint32_t aeMean = static_cast<uint32_t>(aeSum / kNumZones);
+
+	frameCount_++;
+	if (aeEnable_ && frameCount_ >= 3 && (frameCount_ % 3) == 0 && aeMean > 0) {
+		/* Target mid-scale luma (2048 in 12-bit ISP AE units) */
+		constexpr double kTargetAe = 2048.0;
+		double ratio = kTargetAe / static_cast<double>(aeMean);
+		ratio = std::clamp(ratio, 0.7, 1.4);
+		if (std::abs(ratio - 1.0) > 0.08) {
+			double totalExp = static_cast<double>(activeExp) *
+					  static_cast<double>(activeGain) *
+					  (1.0 + 0.5 * (ratio - 1.0));
+			int32_t newExp = static_cast<int32_t>(totalExp / minGain_);
+			int32_t newGain = minGain_;
+			if (newExp > maxExposure_) {
+				newGain = static_cast<int32_t>(
+					totalExp / static_cast<double>(maxExposure_));
+				newGain = std::clamp(newGain, minGain_, maxGain_);
+				newExp = maxExposure_;
+			}
+			newExp = std::clamp(newExp, minExposure_, maxExposure_);
+
+			if (newExp != exposure_ || newGain != gain_) {
+				exposure_ = newExp;
+				gain_ = newGain;
+				ControlList ctrls(sensorControls_);
+				ctrls.set(V4L2_CID_EXPOSURE, exposure_);
+				ctrls.set(V4L2_CID_ANALOGUE_GAIN, gain_);
+				setSensorControls.emit(ctrls);
+			}
+		}
+	}
+
+	aeBaseline_ = aeMean;
+
+	ControlList metadata(controls::controls);
+	metadata.set(controls::ExposureTime, activeExp);
+	metadata.set(controls::AnalogueGain, static_cast<float>(activeGain));
+	std::array<float, 2> cg = { wbR_ / 256.0f, wbB_ / 256.0f };
+	metadata.set(controls::ColourGains, cg);
+
+	statsProcessed.emit(request, metadata);
+}
+
+} /* namespace ipa::sun60i_isp */
+
+extern "C" {
+const struct IPAModuleInfo ipaModuleInfo = {
+	IPA_MODULE_API_VERSION,
+	1,
+	"sun60i-isp",
+	"sun60i-isp",
+};
+
+IPAInterface *ipaCreate()
+{
+	return new ipa::sun60i_isp::IPASun60iIsp();
+}
+
+} /* extern "C" */
+
+} /* namespace libcamera */
