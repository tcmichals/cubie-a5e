+namespace {
+
+const std::map<PixelFormat, V4L2PixelFormat> kCaptureFormats = {
+	{ formats::NV12, V4L2PixelFormat(V4L2_PIX_FMT_NV12) },
+	{ formats::NV21, V4L2PixelFormat(V4L2_PIX_FMT_NV21) },
+	{ formats::YUYV, V4L2PixelFormat(V4L2_PIX_FMT_YUYV) },
+	{ formats::UYVY, V4L2PixelFormat(V4L2_PIX_FMT_UYVY) },
+};
+
+struct Sun60iIspFrameInfo {
+	uint32_t frame;
+	Request *request;
+	FrameBuffer *paramBuffer;
+	FrameBuffer *statBuffer;
+	bool paramDequeued;
+	bool metadataProcessed;
+};
+
+} /* namespace */
+
+class PipelineHandlerSun60iIsp;
+
+class Sun60iIspCameraData : public Camera::Private
+{
+public:
+	Sun60iIspCameraData(PipelineHandler *pipe,
+			    std::unique_ptr<CameraSensor> sensor)
+		: Camera::Private(pipe), sensor_(std::move(sensor))
+	{
+	}
+
+	int loadIPA();
+
+	Stream stream_;
+	std::unique_ptr<CameraSensor> sensor_;
+	std::unique_ptr<DelayedControls> delayedCtrls_;
+	std::unique_ptr<ipa::sun60i_isp::IPAProxySun60iIsp> ipa_;
+
+	std::vector<IPABuffer> ipaParamBuffers_;
+	std::vector<IPABuffer> ipaStatBuffers_;
+	std::map<uint32_t, Sun60iIspFrameInfo> frameInfo_;
+
+private:
+	void paramsComputed(uint32_t request, uint32_t bytesused);
+	void statsProcessed(uint32_t request, const ControlList &metadata);
+	void setSensorControls(const ControlList &sensorControls);
+};
+
+class Sun60iIspCameraConfiguration : public CameraConfiguration
+{
+public:
+	Sun60iIspCameraConfiguration(Sun60iIspCameraData *data)
+		: CameraConfiguration(), data_(data)
+	{
+	}
+
+	Status validate() override;
+
+	V4L2SubdeviceFormat sensorFormat_;
+
+private:
+	Sun60iIspCameraData *data_;
+};
+
+class PipelineHandlerSun60iIsp : public PipelineHandler
+{
+public:
+	PipelineHandlerSun60iIsp(CameraManager *manager);
+
+	std::unique_ptr<CameraConfiguration>
+	generateConfiguration(Camera *camera, Span<const StreamRole> roles) override;
+	int configure(Camera *camera, CameraConfiguration *config) override;
+
+	int exportFrameBuffers(Camera *camera, Stream *stream,
+			       std::vector<std::unique_ptr<FrameBuffer>> *buffers) override;
+
+	int start(Camera *camera, const ControlList *controls) override;
+	void stopDevice(Camera *camera) override;
+
+	int queueRequestDevice(Camera *camera, Request *request) override;
+
+	bool match(DeviceEnumerator *enumerator) override;
+
+	V4L2VideoDevice *params() { return params_.get(); }
+	V4L2VideoDevice *stats() { return stats_.get(); }
+	V4L2VideoDevice *capture() { return capture_.get(); }
+
+	void tryCompleteRequest(Sun60iIspFrameInfo *info);
+
+	std::queue<FrameBuffer *> availableParamsBuffers_;
+
+private:
+	Sun60iIspCameraData *cameraData(Camera *camera)
+	{
+		return static_cast<Sun60iIspCameraData *>(camera->_d());
+	}
+
+	void captureBufferReady(FrameBuffer *buffer);
+	void paramBufferReady(FrameBuffer *buffer);
+	void statBufferReady(FrameBuffer *buffer);
+
+	int allocateBuffers(Camera *camera);
+	void freeBuffers(Camera *camera);
+
+	std::shared_ptr<MediaDevice> media_;
+	std::unique_ptr<V4L2Subdevice> csi2_;
+	std::unique_ptr<V4L2Subdevice> bridge_;
+	std::unique_ptr<V4L2Subdevice> isp_;
+	std::unique_ptr<V4L2VideoDevice> capture_;
+	std::unique_ptr<V4L2VideoDevice> params_;
+	std::unique_ptr<V4L2VideoDevice> stats_;
+
+	std::vector<std::unique_ptr<FrameBuffer>> paramBuffers_;
+	std::vector<std::unique_ptr<FrameBuffer>> statBuffers_;
+	std::queue<FrameBuffer *> availableStatsBuffers_;
+
+	Camera *activeCamera_ = nullptr;
+};
+
+int Sun60iIspCameraData::loadIPA()
+{
+	ipa_ = pipe()->createIPA<ipa::sun60i_isp::IPAProxySun60iIsp>(1, 1);
+	if (!ipa_)
+		return -ENOENT;
+
+	ipa_->paramsComputed.connect(this, &Sun60iIspCameraData::paramsComputed);
+	ipa_->statsProcessed.connect(this, &Sun60iIspCameraData::statsProcessed);
+	ipa_->setSensorControls.connect(this, &Sun60iIspCameraData::setSensorControls);
+
+	IPACameraSensorInfo sensorInfo;
+	int ret = sensor_->sensorInfo(&sensorInfo);
+	if (ret)
+		return ret;
+
+	ipa::sun60i_isp::IPAConfigInfo configInfo{ sensorInfo, sensor_->controls() };
+	ControlInfoMap ipaControls;
+	std::string ipaTuningFile = ipa_->configurationFile(sensor_->model() + ".yaml",
+							    "uncalibrated.yaml");
+	ret = ipa_->init(IPASettings{ ipaTuningFile, sensor_->model() },
+			 configInfo, &ipaControls);
+	if (ret)
+		return ret;
+
+	controlInfo_ = ipaControls;
+	return 0;
+}
+
+void Sun60iIspCameraData::paramsComputed(uint32_t request, uint32_t bytesused)
+{
+	auto it = frameInfo_.find(request);
+	if (it == frameInfo_.end())
+		return;
+
+	Sun60iIspFrameInfo &info = it->second;
+	auto *ph = static_cast<PipelineHandlerSun60iIsp *>(pipe());
+
+	info.paramBuffer->_d()->metadata().planes()[0].bytesused = bytesused;
+	if (bytesused > 0)
+		ph->params()->queueBuffer(info.paramBuffer);
+	else {
+		info.paramDequeued = true;
+		ph->availableParamsBuffers_.push(info.paramBuffer);
+	}
+
+	ph->capture()->queueBuffer(info.request->findBuffer(&stream_));
+}
+
+void Sun60iIspCameraData::statsProcessed(uint32_t request, const ControlList &metadata)
+{
+	auto it = frameInfo_.find(request);
+	if (it == frameInfo_.end())
+		return;
+
+	Sun60iIspFrameInfo &info = it->second;
+	info.request->_d()->metadata().merge(metadata);
+	info.metadataProcessed = true;
+
+	auto *ph = static_cast<PipelineHandlerSun60iIsp *>(pipe());
+	if (info.statBuffer) {
+		ph->stats()->queueBuffer(info.statBuffer);
+		info.statBuffer = nullptr;
+	}
+
+	ph->tryCompleteRequest(&info);
+}
+
+void Sun60iIspCameraData::setSensorControls(const ControlList &sensorControls)
+{
+	delayedCtrls_->push(sensorControls);
+}
+
+CameraConfiguration::Status Sun60iIspCameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty())
+		return Invalid;
+
+	if (config_.size() > 1) {
+		config_.resize(1);
+		status = Adjusted;
+	}
+
+	StreamConfiguration &cfg = config_[0];
+
+	if (kCaptureFormats.find(cfg.pixelFormat) == kCaptureFormats.end()) {
+		cfg.pixelFormat = formats::NV12;
+		status = Adjusted;
+	}
+
+	if (cfg.size.width == 0 || cfg.size.height == 0) {
+		cfg.size = { 1920, 1080 };
+		status = Adjusted;
+	}
+
+	cfg.bufferCount = 4;
+
+	V4L2DeviceFormat format;
+	format.fourcc = kCaptureFormats.at(cfg.pixelFormat);
+	format.size = cfg.size;
+
+	auto *ph = static_cast<PipelineHandlerSun60iIsp *>(data_->pipe());
+	int ret = ph->capture()->tryFormat(&format);
+	if (ret)
+		return Invalid;
+
+	if (cfg.size != format.size) {
+		cfg.size = format.size;
+		status = Adjusted;
+	}
+
+	cfg.stride = format.planes[0].bpl;
+	cfg.frameSize = format.planes[0].size;
+
+	std::vector<unsigned int> mbusCodes = data_->sensor_->mbusCodes();
+	sensorFormat_ = data_->sensor_->getFormat(mbusCodes, cfg.size);
+
+	return status;
+}
+
+PipelineHandlerSun60iIsp::PipelineHandlerSun60iIsp(CameraManager *manager)
+	: PipelineHandler(manager)
+{
+}
+
+std::unique_ptr<CameraConfiguration>
+PipelineHandlerSun60iIsp::generateConfiguration(Camera *camera,
+						Span<const StreamRole> roles)
+{
+	Sun60iIspCameraData *data = cameraData(camera);
+	auto config = std::make_unique<Sun60iIspCameraConfiguration>(data);
+
+	if (roles.empty())
+		return config;
+
+	StreamConfiguration cfg;
+	cfg.pixelFormat = formats::NV12;
+	cfg.size = { 1920, 1080 };
+	cfg.bufferCount = 4;
+
+	config->addConfiguration(cfg);
+	config->validate();
+	return config;
+}
+
+int PipelineHandlerSun60iIsp::configure(Camera *camera, CameraConfiguration *c)
+{
+	auto *config = static_cast<Sun60iIspCameraConfiguration *>(c);
+	Sun60iIspCameraData *data = cameraData(camera);
+	StreamConfiguration &cfg = config->at(0);
+
+	int ret = data->sensor_->setFormat(&config->sensorFormat_);
+	if (ret)
+		return ret;
+
+	V4L2SubdeviceFormat subdevFmt = config->sensorFormat_;
+	ret = csi2_->setFormat(0, &subdevFmt);
+	if (ret)
+		return ret;
+	ret = csi2_->setFormat(1, &subdevFmt);
+	if (ret)
+		return ret;
+
+	ret = bridge_->setFormat(0, &subdevFmt);
+	if (ret)
+		return ret;
+	ret = bridge_->setFormat(1, &subdevFmt);
+	if (ret)
+		return ret;
+
+	ret = isp_->setFormat(0, &subdevFmt);
+	if (ret)
+		return ret;
+
+	V4L2SubdeviceFormat ispSrcFmt = subdevFmt;
+	ispSrcFmt.code = MEDIA_BUS_FMT_UYVY8_1X16;
+	ret = isp_->setFormat(1, &ispSrcFmt);
+	if (ret)
+		return ret;
+
+	V4L2DeviceFormat capFmt;
+	capFmt.fourcc = kCaptureFormats.at(cfg.pixelFormat);
+	capFmt.size = cfg.size;
+	ret = capture_->setFormat(&capFmt);
+	if (ret)
+		return ret;
+
+	cfg.setStream(&data->stream_);
+
+	V4L2DeviceFormat paramFmt;
+	paramFmt.fourcc = V4L2PixelFormat(V4L2_META_FMT_SUN60I_ISP_PARAMS);
+	ret = params_->setFormat(&paramFmt);
+	if (ret)
+		return ret;
+
+	V4L2DeviceFormat statFmt;
+	statFmt.fourcc = V4L2PixelFormat(V4L2_META_FMT_SUN60I_ISP_STAT);
+	ret = stats_->setFormat(&statFmt);
+	if (ret)
+		return ret;
+
+	IPACameraSensorInfo sensorInfo;
+	ret = data->sensor_->sensorInfo(&sensorInfo);
+	if (ret)
+		return ret;
+
+	ipa::sun60i_isp::IPAConfigInfo ipaConfig{ sensorInfo, data->sensor_->controls() };
+	ControlInfoMap ipaControls;
+	ret = data->ipa_->configure(ipaConfig, &ipaControls);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+int PipelineHandlerSun60iIsp::exportFrameBuffers([[maybe_unused]] Camera *camera,
+						 Stream *stream,
+						 std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	unsigned int count = stream->configuration().bufferCount;
+	return capture_->exportBuffers(count, buffers);
+}
+
+int PipelineHandlerSun60iIsp::allocateBuffers(Camera *camera)
+{
+	Sun60iIspCameraData *data = cameraData(camera);
+	constexpr unsigned int kMetaBufferCount = 4;
+
+	int ret = params_->allocateBuffers(kMetaBufferCount, &paramBuffers_);
+	if (ret < 0)
+		return ret;
+
+	ret = stats_->allocateBuffers(kMetaBufferCount, &statBuffers_);
+	if (ret < 0) {
+		freeBuffers(camera);
+		return ret;
+	}
+
+	unsigned int ipaBufferId = 1;
+	for (const std::unique_ptr<FrameBuffer> &buf : paramBuffers_) {
+		Span<const FrameBuffer::Plane> planes = buf->planes();
+		buf->setCookie(ipaBufferId++);
+		data->ipaParamBuffers_.emplace_back(buf->cookie(),
+						    std::vector<FrameBuffer::Plane>{ planes.begin(),
+										     planes.end() });
+		availableParamsBuffers_.push(buf.get());
+	}
+
+	for (const std::unique_ptr<FrameBuffer> &buf : statBuffers_) {
+		Span<const FrameBuffer::Plane> planes = buf->planes();
+		buf->setCookie(ipaBufferId++);
+		data->ipaStatBuffers_.emplace_back(buf->cookie(),
+						   std::vector<FrameBuffer::Plane>{ planes.begin(),
+										    planes.end() });
+		availableStatsBuffers_.push(buf.get());
+	}
+
+	data->ipa_->mapBuffers(data->ipaParamBuffers_, false);
+	data->ipa_->mapBuffers(data->ipaStatBuffers_, true);
+
+	return 0;
+}
+
+void PipelineHandlerSun60iIsp::freeBuffers(Camera *camera)
+{
+	Sun60iIspCameraData *data = cameraData(camera);
+
+	while (!availableParamsBuffers_.empty())
+		availableParamsBuffers_.pop();
+	while (!availableStatsBuffers_.empty())
+		availableStatsBuffers_.pop();
+
+	data->ipa_->unmapBuffers(data->ipaParamBuffers_);
+	data->ipa_->unmapBuffers(data->ipaStatBuffers_);
+	data->ipaParamBuffers_.clear();
+	data->ipaStatBuffers_.clear();
+
+	paramBuffers_.clear();
+	statBuffers_.clear();
+
+	params_->releaseBuffers();
+	stats_->releaseBuffers();
+}
+
+int PipelineHandlerSun60iIsp::start(Camera *camera,
+				     [[maybe_unused]] const ControlList *controls)
+{
+	Sun60iIspCameraData *data = cameraData(camera);
+	int ret;
+
+	ret = allocateBuffers(camera);
+	if (ret)
+		return ret;
+
+	ret = data->ipa_->start();
+	if (ret) {
+		freeBuffers(camera);
+		return ret;
+	}
+
+	data->delayedCtrls_->reset();
+
+	ret = params_->streamOn();
+	if (ret) {
+		data->ipa_->stop();
+		freeBuffers(camera);
+		return ret;
+	}
+
+	ret = stats_->streamOn();
+	if (ret) {
+		params_->streamOff();
+		data->ipa_->stop();
+		freeBuffers(camera);
+		return ret;
+	}
+
+	while (!availableStatsBuffers_.empty()) {
+		stats_->queueBuffer(availableStatsBuffers_.front());
+		availableStatsBuffers_.pop();
+	}
+
+	ret = capture_->importBuffers(data->stream_.configuration().bufferCount);
+	if (ret) {
+		stats_->streamOff();
+		params_->streamOff();
+		data->ipa_->stop();
+		freeBuffers(camera);
+		return ret;
+	}
+
+	ret = capture_->streamOn();
+	if (ret) {
+		capture_->releaseBuffers();
+		stats_->streamOff();
+		params_->streamOff();
+		data->ipa_->stop();
+		freeBuffers(camera);
+		return ret;
+	}
+
+	activeCamera_ = camera;
+	return 0;
+}
+
+void PipelineHandlerSun60iIsp::stopDevice(Camera *camera)
+{
+	Sun60iIspCameraData *data = cameraData(camera);
+
+	activeCamera_ = nullptr;
+
+	capture_->streamOff();
+	capture_->releaseBuffers();
+	stats_->streamOff();
+	params_->streamOff();
+
+	data->ipa_->stop();
+	freeBuffers(camera);
+	data->frameInfo_.clear();
+}
+
+int PipelineHandlerSun60iIsp::queueRequestDevice(Camera *camera, Request *request)
+{
+	Sun60iIspCameraData *data = cameraData(camera);
+
+	if (availableParamsBuffers_.empty())
+		return -ENOBUFS;
+
+	FrameBuffer *paramBuf = availableParamsBuffers_.front();
+	availableParamsBuffers_.pop();
+
+	Sun60iIspFrameInfo info{
+		.frame = request->sequence(),
+		.request = request,
+		.paramBuffer = paramBuf,
+		.statBuffer = nullptr,
+		.paramDequeued = false,
+		.metadataProcessed = false,
+	};
+	data->frameInfo_[request->sequence()] = info;
+
+	data->ipa_->queueRequest(request->sequence(), request->controls());
+	data->ipa_->fillParams(request->sequence(), paramBuf->cookie());
+
+	return 0;
+}
+
+void PipelineHandlerSun60iIsp::tryCompleteRequest(Sun60iIspFrameInfo *info)
+{
+	if (!activeCamera_)
+		return;
+
+	if (info->request->hasPendingBuffers())
+		return;
+
+	if (!info->metadataProcessed || !info->paramDequeued)
+		return;
+
+	Sun60iIspCameraData *data = cameraData(activeCamera_);
+	Request *req = info->request;
+	data->frameInfo_.erase(req->sequence());
+	completeRequest(req);
+}
+
+void PipelineHandlerSun60iIsp::captureBufferReady(FrameBuffer *buffer)
+{
+	if (!activeCamera_)
+		return;
+
+	Sun60iIspCameraData *data = cameraData(activeCamera_);
+	Request *request = buffer->request();
+
+	completeBuffer(request, buffer);
+
+	auto it = data->frameInfo_.find(request->sequence());
+	if (it != data->frameInfo_.end())
+		tryCompleteRequest(&it->second);
+}
+
+void PipelineHandlerSun60iIsp::paramBufferReady(FrameBuffer *buffer)
+{
+	availableParamsBuffers_.push(buffer);
+
+	if (!activeCamera_)
+		return;
+
+	Sun60iIspCameraData *data = cameraData(activeCamera_);
+	for (auto &[seq, info] : data->frameInfo_) {
+		if (info.paramBuffer == buffer) {
+			info.paramDequeued = true;
+			tryCompleteRequest(&info);
+			break;
+		}
+	}
+}
+
+void PipelineHandlerSun60iIsp::statBufferReady(FrameBuffer *buffer)
+{
+	if (!activeCamera_)
+		return;
+
+	if (buffer->metadata().status == FrameMetadata::FrameCancelled)
+		return;
+
+	Sun60iIspCameraData *data = cameraData(activeCamera_);
+
+	/* Match oldest frame awaiting stats */
+	Sun60iIspFrameInfo *target = nullptr;
+	for (auto &[seq, info] : data->frameInfo_) {
+		if (!info.metadataProcessed && !info.statBuffer) {
+			target = &info;
+			break;
+		}
+	}
+
+	if (!target) {
+		stats_->queueBuffer(buffer);
+		return;
+	}
+
+	target->statBuffer = buffer;
+	data->ipa_->processStats(target->frame, buffer->cookie(),
+				 data->delayedCtrls_->get(buffer->metadata().sequence));
+}
+
+bool PipelineHandlerSun60iIsp::match(DeviceEnumerator *enumerator)
+{
+	DeviceMatch dm("sun6i-csi");
+	dm.add("sun6i-csi-capture");
+	dm.add("sun60i-isp");
+	dm.add("sun60i-isp-params");
+	dm.add("sun60i-isp-stats");
+
+	media_ = acquireMediaDevice(enumerator, dm);
+	if (!media_)
+		return false;
+
+	csi2_ = V4L2Subdevice::fromEntityName(media_.get(), "sun6i-mipi-csi2");
+	bridge_ = V4L2Subdevice::fromEntityName(media_.get(), "sun6i-csi-bridge");
+	isp_ = V4L2Subdevice::fromEntityName(media_.get(), "sun60i-isp");
+	capture_ = V4L2VideoDevice::fromEntityName(media_.get(), "sun6i-csi-capture");
+	params_ = V4L2VideoDevice::fromEntityName(media_.get(), "sun60i-isp-params");
+	stats_ = V4L2VideoDevice::fromEntityName(media_.get(), "sun60i-isp-stats");
+
+	if (!csi2_ || !bridge_ || !isp_ || !capture_ || !params_ || !stats_)
+		return false;
+
+	if (csi2_->open() || bridge_->open() || isp_->open() ||
+	    capture_->open() || params_->open() || stats_->open())
+		return false;
+
+	capture_->bufferReady.connect(this, &PipelineHandlerSun60iIsp::captureBufferReady);
+	params_->bufferReady.connect(this, &PipelineHandlerSun60iIsp::paramBufferReady);
+	stats_->bufferReady.connect(this, &PipelineHandlerSun60iIsp::statBufferReady);
+
+	bool registered = false;
+	for (MediaEntity *entity : media_->entities()) {
+		if (entity->function() != MEDIA_ENT_F_CAM_SENSOR)
+			continue;
+
+		std::unique_ptr<CameraSensor> sensor = CameraSensorFactoryBase::create(entity);
+		if (!sensor)
+			continue;
+
+		auto data = std::make_unique<Sun60iIspCameraData>(this, std::move(sensor));
+		if (data->loadIPA())
+			continue;
+
+		const CameraSensorProperties::SensorDelays &delays =
+			data->sensor_->sensorDelays();
+		std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+			{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+			{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+		};
+		data->delayedCtrls_ =
+			std::make_unique<DelayedControls>(data->sensor_->device(), params);
+		isp_->frameStart.connect(data->delayedCtrls_.get(),
+					 &DelayedControls::applyControls);
+
+		data->properties_ = data->sensor_->properties();
+		std::string name = data->sensor_->id();
+		std::set<Stream *> streams{ &data->stream_ };
+		std::shared_ptr<Camera> camera =
+			Camera::create(std::move(data), name, streams);
+		registerCamera(std::move(camera));
+		registered = true;
+	}
+
+	return registered;
+}
+
+REGISTER_PIPELINE_HANDLER(PipelineHandlerSun60iIsp, "sun60i-isp")
+
+} /* namespace libcamera */
