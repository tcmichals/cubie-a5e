+    'sun60i_isp.cpp',
+])
+
+mod = shared_module(ipa_name,
+                    sun60i_isp_ipa_sources,
+                    name_prefix : '',
+                    include_directories : [ipa_includes, libipa_includes],
+                    dependencies : libcamera_private,
+                    link_with : libipa,
+                    install : true,
