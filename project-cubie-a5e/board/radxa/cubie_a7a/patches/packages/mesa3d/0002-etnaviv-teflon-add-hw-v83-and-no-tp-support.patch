 }
+
+void
+etna_ml_execute_operation_tp_cpu(struct pipe_context *pctx,
+                                 struct etna_vip_instruction *operation)
+{
+   struct pipe_transfer *src_xfer = NULL;
+   struct pipe_transfer *dst_xfer = NULL;
+   unsigned in_size = operation->tp_cpu.input_width *
+                      operation->tp_cpu.input_height *
+                      operation->tp_cpu.input_channels;
+   unsigned out_size = operation->tp_cpu.output_width *
+                       operation->tp_cpu.output_height *
+                       operation->tp_cpu.output_channels;
+   const uint8_t *src = pipe_buffer_map_range(pctx, operation->input,
+                                              operation->input_offset, in_size,
+                                              PIPE_MAP_READ, &src_xfer);
+   uint8_t *dst = pipe_buffer_map_range(pctx, operation->output,
+                                        operation->output_offset, out_size,
+                                        PIPE_MAP_WRITE, &dst_xfer);
+   assert(src && dst);
+
+   unsigned W = operation->tp_cpu.input_width;
+   unsigned H = operation->tp_cpu.input_height;
+   unsigned C = operation->tp_cpu.input_channels;
+
+   switch (operation->tp_type) {
+   case ETNA_ML_TP_TRANSPOSE:
+      /* NHWC [W][H][C] -> NCHW [C][W][H] */
+      for (unsigned c = 0; c < C; c++) {
+         for (unsigned w = 0; w < W; w++) {
+            for (unsigned h = 0; h < H; h++) {
+               dst[c * W * H + w * H + h] = src[w * H * C + h * C + c];
+            }
+         }
+      }
+      break;
+   case ETNA_ML_TP_DETRANSPOSE:
+      /* NCHW [C][W][H] -> NHWC [W][H][C] */
+      for (unsigned c = 0; c < C; c++) {
+         for (unsigned w = 0; w < W; w++) {
+            for (unsigned h = 0; h < H; h++) {
+               dst[w * H * C + h * C + c] = src[c * W * H + w * H + h];
+            }
+         }
+      }
+      break;
+   case ETNA_ML_TP_RESHUFFLE: {
+      unsigned S = operation->tp_cpu.stride;
+      unsigned out_W = operation->tp_cpu.output_width;
+      unsigned out_H = operation->tp_cpu.output_height;
+      int pad_w = 0;
+      int pad_h = 0;
+      if (operation->tp_cpu.padding_same) {
+         if (operation->tp_cpu.weight_width == 5) {
+            pad_w++;
+            pad_h++;
+         }
+         if (W % 2)
+            pad_w++;
+         if (H % 2)
+            pad_h++;
+      }
+      for (unsigned c = 0; c < C; c++) {
+         for (unsigned dw = 0; dw < S; dw++) {
+            for (unsigned dh = 0; dh < S; dh++) {
+               unsigned out_c = c * S * S + dw * S + dh;
+               for (unsigned ow = 0; ow < out_W; ow++) {
+                  for (unsigned oh = 0; oh < out_H; oh++) {
+                     int iw = (int)(ow * S + dw) - pad_w;
+                     int ih = (int)(oh * S + dh) - pad_h;
+                     uint8_t val = operation->tp_cpu.input_zero_point;
+                     if (iw >= 0 && iw < (int)W && ih >= 0 && ih < (int)H)
+                        val = src[c * W * H + (unsigned)iw * H + (unsigned)ih];
+                     dst[out_c * out_W * out_H + ow * out_H + oh] = val;
+                  }
+               }
+            }
+         }
+      }
+      break;
+   }
+   default:
+      UNREACHABLE("Unsupported CPU TP fallback operation");
+   }
+
+   pipe_buffer_unmap(pctx, dst_xfer);
+   pipe_buffer_unmap(pctx, src_xfer);
+}
