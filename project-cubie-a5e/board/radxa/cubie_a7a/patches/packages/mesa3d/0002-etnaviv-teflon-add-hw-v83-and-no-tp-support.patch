-   if (nn_core_version == 8)
-      shift += 1;
-   else
-      shift += 16;
+   unsigned shift;
+   if (has_fp_post_scale) {
+      /* HW_V83 cores with FP_INIMAGE_POST_SCALE take the raw IEEE-754 biased
