> +			priv->dram_phys =3D res.start;
> +			priv->dram_size =3D resource_size(&res);
> +			priv->dram_va =3D devm_memremap(dev, res.start, resource_size(&res),
> +						      MEMREMAP_WB);
[ ... ]
> +		}
> +
