From 5507249f81cedecc89e5c05db434ae91fc2b36a7 Mon Sep 17 00:00:00 2001
From: Tim Michals <tcmichals@gmail.com>
Date: Thu, 15 Oct 2026 19:46:21 -0500
Subject: [PATCH v3 7/7] remoteproc: sunxi: Add KUnit tests

Add 25 KUnit tests for the sunxi remoteproc driver: address translation
of both SRAM windows by core and host address, their exact bounds,
rejection of addresses outside them (including zero length, u64
overflow and the DSP RAM), DRAM left to the core's carveout lookup,
boot address programming and its 32-bit limit, the remap bit and SRAM
clearing in .prepare() and .unprepare(), carveout registration across
restarts, and the mailbox receive callback deferring to the workqueue.

Like the message box tests, they use a fake register bank in plain
memory and depend on ARM64 or COMPILE_TEST.
---
 drivers/remoteproc/Kconfig            |  12 +
 drivers/remoteproc/Makefile           |   1 +
 drivers/remoteproc/sunxi_rproc_test.c | 606 ++++++++++++++++++++++++++
 3 files changed, 619 insertions(+)
 create mode 100644 drivers/remoteproc/sunxi_rproc_test.c

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
index d8fb5d67706e..fd1ea71e169d 100644
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -397,6 +397,18 @@ config SUNXI_REMOTEPROC
 	  co-processor on Allwinner A523, A527, and T527 SoCs via the
 	  remote processor framework.
 
+config SUNXI_REMOTEPROC_KUNIT_TEST
+	tristate "KUnit tests for Allwinner sunxi remoteproc" if !KUNIT_ALL_TESTS
+	# The tests use plain memory as fake MMIO, which readl()/writel()
+	# only handle like registers on the architectures below.
+	depends on SUNXI_REMOTEPROC && KUNIT && (ARM64 || COMPILE_TEST) && !UML
+	default KUNIT_ALL_TESTS
+	help
+	  KUnit tests for the Allwinner sunxi_rproc driver, covering
+	  da_to_va() address translation logic and boundary conditions
+	  across dedicated SRAM spaces, DRAM carveouts, and trace regions.
+	  Say Y here to run these tests during boot or via kunit.py.
+
 endif # REMOTEPROC
 
 endmenu
diff --git a/drivers/remoteproc/Makefile b/drivers/remoteproc/Makefile
