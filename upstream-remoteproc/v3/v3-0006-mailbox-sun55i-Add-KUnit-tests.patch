+	KUNIT_EXPECT_EQ(test, fix->sinks[8].count, 2);
+	KUNIT_EXPECT_EQ(test, mock_read_reg(fix, 0, SUNXI_MSGBOX_MSG_STATUS(2, 0) / 4), 0U);
+	KUNIT_EXPECT_EQ(test, mock_read_reg(fix, 0, stat_idx) & RD_IRQ_PEND_BIT(0), 0U);
+}
