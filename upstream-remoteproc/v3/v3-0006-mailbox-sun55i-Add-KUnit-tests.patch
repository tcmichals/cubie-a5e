+static void test_irq_clears_pending_after_drain(struct kunit *test)
+{
+	struct mock_msgbox_fixture *fix = create_mock_fixture(test);
+	u32 en_idx = SUNXI_MSGBOX_READ_IRQ_ENABLE(2) / 4;
