+	mock_write_reg(fix, 0, stat_idx, RD_IRQ_PEND_BIT(0));
+	mock_write_reg(fix, 0, SUNXI_MSGBOX_MSG_STATUS(2, 0) / 4, 2);
+	mock_write_reg(fix, 0, SUNXI_MSGBOX_MSG_FIFO(2, 0) / 4, 0xCAFEF00D);
